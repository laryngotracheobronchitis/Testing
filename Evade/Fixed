    local tg = Instance.new("UIGradient")
    tg.Color = ColorSequence.new({ColorSequenceKeypoint.new(0,Color3.fromRGB(255,255,255)),ColorSequenceKeypoint.new(1,Color3.fromRGB(194,194,194))})
    tg.Rotation = 90
    tg.Parent = TimeDisplay
    return { ScreenGui = ScreenGui, TimeDisplay = TimeDisplay, StatusLabel = StatusLabel, MainTimer = MainTimer }
end

local function destroyTimerGUI()
    if _attributeConnection then _attributeConnection:Disconnect() _attributeConnection = nil end
    if _attributeConnection2 then _attributeConnection2:Disconnect() _attributeConnection2 = nil end
    CheckingGameTimer = false
    if TimerGUI then TimerGUI.ScreenGui:Destroy() TimerGUI = nil end
    TimerEnabled = false
end
local function ensureTimerGUI() if not TimerGUI then TimerGUI = createTimerGUI() end end
local function SetTime(seconds)
    if not TimerGUI then return end
    if type(seconds) == "number" then
        local m2 = math.floor(seconds/60); local s2 = math.floor(seconds%60)
        TimerGUI.TimeDisplay.Text = string.format("%d:%02d", m2, s2)
        local col = seconds <= 5 and Color3.fromRGB(215,100,100) or Color3.fromRGB(165,194,255)
        TimerGUI.TimeDisplay.TextColor3 = col
        TimerGUI.StatusLabel.TextColor3 = col
    else TimerGUI.TimeDisplay.Text = tostring(seconds) end
end
local function SetStatus(text) if not TimerGUI then return end TimerGUI.StatusLabel.Text = text:upper() end
local function CheckGameTimerVisibility()
    if not TimerEnabled or not TimerGUI then if TimerGUI then TimerGUI.MainTimer.Visible = false end return end
    local hud = localPlayer.PlayerGui:FindFirstChild("Shared")
    if hud then hud = hud:FindFirstChild("HUD") end
    if hud then hud = hud:FindFirstChild("Overlay") end
    if hud then hud = hud:FindFirstChild("Default") end
    if hud then hud = hud:FindFirstChild("RoundOverlay") end
    if hud then hud = hud:FindFirstChild("Round") end
    local roundTimer = hud and hud:FindFirstChild("RoundTimer")
    if roundTimer and roundTimer.Visible then TimerGUI.MainTimer.Visible = false
    else TimerGUI.MainTimer.Visible = OriginalTimerVisible end
end
local function StartGameTimerCheck()
    if CheckingGameTimer then return end
    CheckingGameTimer = true
    spawn(function() while CheckingGameTimer do CheckGameTimerVisibility() wait(0.1) end end)
end
local function UpdateFromAttributes()
    local statsFolder = workspace:FindFirstChild("Game")
    if statsFolder then statsFolder = statsFolder:FindFirstChild("Stats") end
    if not statsFolder then return end
    local timerValue = statsFolder:GetAttribute("Timer")
    local roundStarted = statsFolder:GetAttribute("RoundStarted")
    if timerValue then SetTime(timerValue) end
    if roundStarted ~= nil then SetStatus(roundStarted and "Round Active" or "Intermission") end
end
local function StartAttributeMonitor()
    if _attributeConnection then _attributeConnection:Disconnect() _attributeConnection = nil end
    if _attributeConnection2 then _attributeConnection2:Disconnect() _attributeConnection2 = nil end
    local statsFolder = workspace:FindFirstChild("Game")
    if statsFolder then statsFolder = statsFolder:FindFirstChild("Stats") end
    if not statsFolder then return end
    _attributeConnection = statsFolder:GetAttributeChangedSignal("Timer"):Connect(UpdateFromAttributes)
    _attributeConnection2 = statsFolder:GetAttributeChangedSignal("RoundStarted"):Connect(UpdateFromAttributes)
    UpdateFromAttributes()
end
local function SetTimerVisible(visible)
    TimerEnabled = visible
    OriginalTimerVisible = visible
    if CheckingGameTimer then CheckGameTimerVisibility()
    elseif TimerGUI then TimerGUI.MainTimer.Visible = visible end
end
local function handleTimerToggles()
    if not TimerEnabled then destroyTimerGUI()
    else ensureTimerGUI() SetTimerVisible(true) StartAttributeMonitor() StartGameTimerCheck() end
end

