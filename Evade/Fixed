-- 6. COLA LOGIC (Fixed)
-- ==============================================================================
local ToolAction = ReplicatedStorage.Events.Character.ToolAction
local SpeedBoostEvent = ReplicatedStorage.Events.Character.SpeedBoost

local ColaCheat = {
    UnlimitedCola = false,
    CustomSpeed = 1.4,
    CustomDuration = 3.5,
    FixAnimation = false
}

local colaState = {
    isDrinking = false,
    lastDrinkTime = 0
}

local mt = getrawmetatable(ToolAction)
local oldNamecall = mt.__namecall
setreadonly(mt, false)
mt.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    local args = { ... }
    
    if method == "FireServer" and self == ToolAction then
        local actionType = args[1]
        
        if actionType == 0 then
            colaState.isDrinking = true
            colaState.lastDrinkTime = tick()
            
            if ColaCheat.FixAnimation then
                task.spawn(function()
                    local char = player.Character
                    if char then
                        local humanoid = char:FindFirstChildOfClass("Humanoid")
                        if humanoid then
                            task.wait(0.15)
                            if humanoid:GetState() ~= Enum.HumanoidStateType.Dead then
                                humanoid:ChangeState(Enum.HumanoidStateType.Running)
                            end
                        end
                    end
                end)
            end
            
            if ColaCheat.CustomSpeed and ColaCheat.CustomDuration then
                local delayTime = ColaCheat.FixAnimation and 0.05 or 0.4
                task.delay(delayTime, function()
                    pcall(function()
                        firesignal(SpeedBoostEvent.OnClientEvent, "Drink", ColaCheat.CustomSpeed, ColaCheat.CustomDuration, Color3.new(1, 1, 1))
                    end)
                end)
            end
        end
        
        if actionType == 2 then
            if ColaCheat.UnlimitedCola and colaState.isDrinking then
                colaState.isDrinking = false
                return nil
            end
            colaState.isDrinking = false
        end
    end
    
    return oldNamecall(self, ...)
end)
setreadonly(mt, true)

local function setupAnimationFix()
    spawn(function()
        while task.wait(0.1) do
            if ColaCheat.FixAnimation and colaState.isDrinking then
                local char = player.Character
                if char then
                    local anim = char:FindFirstChildOfClass("Animator")
                    if anim then
                        for _, track in ipairs(anim:GetPlayingAnimationTracks()) do
                            local animName = track.Animation and track.Animation.Name or ""
                            if animName:lower():find("drink") or animName:lower():find("cola") or animName:lower():find("consume") then
                                track:AdjustSpeed(10)
                                task.wait(0.1)
                                track:Stop()
                            end
                        end
                    end
                end
            end
        end
    end)
end

setupAnimationFix()

