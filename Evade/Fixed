local function findMovementInstances()
    movementInstances = {}
    for _, v in pairs(getgc(true)) do
        if type(v) == "table" and rawget(v, "defaultMovementStats") then
            table.insert(movementInstances, v)
        end
    end
    return #movementInstances > 0
end

local function applySavedMovementStats()
    task.spawn(function()
        for i = 1, 10 do
            task.wait(0.5)
            if findMovementInstances() then
                for _, instance in ipairs(movementInstances) do
                    if instance and instance.overrideMovementStats then
                        instance.overrideMovementStats["AirStrafeAcceleration"] = tonumber(savedMovementStats.AirStrafeAcceleration)
                        instance.overrideMovementStats["JumpCap"] = tonumber(savedMovementStats.JumpCap)
                    end
                end
                break
            end
        end
    end)
end

