-- ======================= AUTO RESPAWN SYSTEM ============================
-- New respawn features:
--   * Auto Respawn on Death (toggle)
--   * Respawn Delay (seconds, 0 = instant)
--   * Instant Respawn (manual button)
--   * Force Respawn (manual button, fires SetPlayerMode)
-- ======================================================================
local AutoRespawn = {
Enabled = false,
Delay = 0,
LastFireTime = 0,
DeathConn = nil,
CharConn = nil,
IsDead = false,
}

function AutoRespawn:IsDeadNow()
local char = LocalPlayer.Character
if not char then return true end
local hum = char:FindFirstChildOfClass("Humanoid")
if not hum then return true end
if hum.Health <= 0 then return true end

-- also check the death GUI (game-side death)
local shared = PlayerGui:FindFirstChild("Shared")
if shared then
local respawn = shared:FindFirstChild("Respawn")
if respawn then
local types = respawn:FindFirstChild("Types")
if types then
local death = types:FindFirstChild("Death")
if death and death.Visible then
return true
end
end
end
end
local menu = PlayerGui:FindFirstChild("Menu")
if menu then return true end

-- check downed state via charData
local charData = CharacterService:GetCharacterFromPlayer(LocalPlayer)
if charData and charData.DataRegistry:Get("Downed") then
return false -- downed, not dead
end

return false
end

function AutoRespawn:FireRespawn()
local now = tick()
if now - self.LastFireTime < 0.5 then return end
self.LastFireTime = now
pcall(function()
changePlayerMode:FireServer(true)
end)
end

function AutoRespawn:Start()
if self.Enabled then return end
self.Enabled = true

-- Watch death via Humanoid.Died
self.DeathConn = RunService.Heartbeat:Connect(function()
if not self.Enabled then return end
local dead = self:IsDeadNow()
if dead and not self.IsDead then
self.IsDead = true
task.delay(self.Delay, function()
if not self.Enabled then return end
if self:IsDeadNow() then
self:FireRespawn()
end
end)
elseif not dead and self.IsDead then
self.IsDead = false
end
end)

-- Reset state on new character
self.CharConn = LocalPlayer.CharacterAdded:Connect(function()
self.IsDead = false
self.LastFireTime = 0
end)
end

function AutoRespawn:Stop()
self.Enabled = false
self.IsDead = false
if self.DeathConn then
self.DeathConn:Disconnect()
self.DeathConn = nil
end
if self.CharConn then
self.CharConn:Disconnect()
self.CharConn = nil
end
end

