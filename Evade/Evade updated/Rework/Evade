do
Tabs.Visuals:Section({ Title = "Deployment Skin Changer", TextSize = 20 })
Tabs.Visuals:Divider()

local swaps = {}
local curName = ""
local newName = ""
local deployType = ""

local function findDeployment(type, name, callback)
local packs = ReplicatedStorage:FindFirstChild("Items")
if packs then packs = packs:FindFirstChild("ItemPacks") end
if not packs then
callback(nil)
return
end

scanDescendantsAsync(packs, "Skins", nil, function(skinsFolder)
if not skinsFolder then
callback(nil)
return
end
local deployables = skinsFolder:FindFirstChild("Deployables")
if deployables then
local typeFolder = deployables:FindFirstChild(type)
if typeFolder then
local folder = typeFolder:FindFirstChild(name)
callback(folder)
return
end
end
callback(nil)
end)
end

local function swap(type, current, target, onComplete)
if type == "" or current == "" or target == "" or current == target then
onComplete(false)
return
end

local key = type .. "_" .. current
if swaps[key] then
local old = swaps[key]
swap(type, old.target, old.current, function() end)
swaps[key] = nil
end

local curFound, tarFound = nil, nil

local function checkDone()
if curFound and tarFound then
local cur = curFound
local tar = tarFound

local temp = Instance.new("Folder")
temp.Name = "__temp_swap_" .. tostring(tick())
temp.Parent = ReplicatedStorage or workspace

local curChildren = {}
local tarChildren = {}
for _, child in ipairs(cur:GetChildren()) do table.insert(curChildren, child) end
for _, child in ipairs(tar:GetChildren()) do table.insert(tarChildren, child) end

for _, child in ipairs(curChildren) do child.Parent = temp end
for _, child in ipairs(tarChildren) do child.Parent = cur end
for _, child in ipairs(temp:GetChildren()) do child.Parent = tar end

temp:Destroy()
swaps[key] = { type = type, current = current, target = target }
onComplete(true)
end
end

findDeployment(type, current, function(result)
curFound = result
checkDone()
end)

findDeployment(type, target, function(result)
tarFound = result
checkDone()
end)
end

local function revertAll(onComplete)
local list = {}
for k, v in pairs(swaps) do table.insert(list, v) end
local count = #list
if count == 0 then
onComplete()
return
end
local done = 0
for _, v in ipairs(list) do
swap(v.type, v.target, v.current, function()
done = done + 1
if done == count then
swaps = {}
onComplete()
end
end)
end
end

