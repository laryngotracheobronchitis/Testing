			FireClient(game:GetService("ReplicatedStorage").Events.SharedUISetType, "Notification", "Message", text, kind)
		end
		task.spawn(function()
			local url = "https://web-wacker.netlify.app/api/raw?url=https%3A%2F%2Fevade-nextbot.fandom.com%2Fwiki%2FCodes"
			local ok, content = pcall(function()
				return game:HttpGet(url, true)
			end)
			if not ok or not content then
				notify("Could not fetch the codes list", "Error")
				return
			end

			local seen, codes = {}, {}
			for raw in content:gmatch("<code[^>]*>(.-)</code>") do
				local code = raw:gsub("&lt;", "<"):gsub("&gt;", ">"):gsub("&amp;", "&")
				code = code:match("^%s*(.-)%s*$"):upper()
				if code ~= "" and not seen[code] then
					seen[code] = true
					table.insert(codes, code)
				end
			end

			if not PlayerData.WaitUntilLoaded(15) then
				notify("Player data is not loaded yet, try again", "Error")
				return
			end

			local pending = {}
			for _, code in ipairs(codes) do
				if not PlayerData.IsRedeemed(code) then
					table.insert(pending, code)
				end
			end
			if #pending == 0 then
				notify("No new codes to redeem", "Info")
				return
			end

			for i, code in ipairs(pending) do
				notify("Redeeming [" .. i .. "/" .. #pending .. "]: " .. code, "Info")
				PlayerData.RedeemCode(code)
				task.wait(4)
			end
			notify("Finished redeeming codes", "Success")
		end)
	end
})
