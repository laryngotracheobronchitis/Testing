local function getEmoteIDByName(name)
	if not DaraItemRegistry then
		return nil
	end
	local wanted = name:lower() -- FIX: guard ItemRegistry nil (fitur degradasi, tidak crash)
	for _, id in ipairs(PlayerData.OwnedIds()) do
		local config = DaraItemRegistry.GetConfig(id)
		if config and config.EquipInfo and config.EquipInfo.SlotType == "Emote" then
			local entry = DaraItemRegistry.TryGetById(id)
			local itemName = entry and entry.Module and entry.Module.Name
			local displayName = config.AppearanceInfo and config.AppearanceInfo.Name
			if (itemName and itemName:lower() == wanted) or (displayName and displayName:lower() == wanted) then
				return id
			end
		end
	end
	return nil
end

