local function getRootPart(model)
    if typeof(model) ~= "Instance" then return nil end
    if model:IsA("BasePart") then return model end
    return model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
end

local function teleportTo(target)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then
        WindUI:Notify({ Title = "Teleport", Content = "Karakter belum siap.", Duration = 3 })
        return false
    end
    local cf = nil
    if typeof(target) == "Instance" then
        local part = getRootPart(target)
        if part then cf = part.CFrame end
    elseif typeof(target) == "CFrame" then
        cf = target
    elseif typeof(target) == "Vector3" then
        cf = CFrame.new(target)
    end
    if not cf then
        WindUI:Notify({ Title = "Teleport", Content = "Target tidak valid.", Duration = 3 })
        return false
    end
    hrp.CFrame = cf + Vector3.new(0, 3, 0) -- offset kecil supaya tidak nempel/nge-clip
    return true
end

-- REKONSTRUKSI: cara mencari spawn/NPC/objective/ticket tidak terlihat di lampiran
local function getSpawnCFrame()
    local spawnLocation = workspace:FindFirstChildWhichIsA("SpawnLocation", true)
    if spawnLocation then
        return spawnLocation.CFrame
    end
    local map = workspace:FindFirstChild("Map")
    if map then
        local spawnFolder = map:FindFirstChild("Spawns", true) or map:FindFirstChild("Spawn", true)
        if spawnFolder then
            if spawnFolder:IsA("BasePart") then
                return spawnFolder.CFrame
            end
            return spawnFolder:GetPivot()
        end
    end
    return nil
end

local function looksLikeNPC(model)
    return model:FindFirstChildOfClass("Humanoid") ~= nil
        or model:FindFirstChildOfClass("BillboardGui") ~= nil
        or model:FindFirstChildOfClass("SurfaceGui") ~= nil
end

local function collectNPCs()
    local npcs, seen = {}, {}
    local function tryAdd(model)
        if typeof(model) ~= "Instance" or not model:IsA("Model") then return end
        if Players:GetPlayerFromCharacter(model) then return end
        if getRootPart(model) and looksLikeNPC(model) and not seen[model] then
            seen[model] = true
            table.insert(npcs, model)
        end
    end
    for _, name in ipairs({ "NPCs", "NPC", "Npcs", "Nextbots", "Bots" }) do
        local container = workspace:FindFirstChild(name)
        if container then
            for _, child in ipairs(container:GetChildren()) do
                tryAdd(child)
            end
        end
    end
    if #npcs == 0 then
        for _, child in ipairs(workspace:GetChildren()) do
            tryAdd(child)
        end
    end
    return npcs
end

local function collectObjectives()
    local objectives, seen = {}, {}
    for _, name in ipairs({ "Objectives", "Objective" }) do
        local container = workspace:FindFirstChild(name)
        if container then
            for _, child in ipairs(container:GetChildren()) do
                if (child:IsA("BasePart") or child:IsA("Model")) and not seen[child] then
                    seen[child] = true
                    table.insert(objectives, child)
                end
            end
        end
    end
    if #objectives == 0 then
        for _, d in ipairs(workspace:GetDescendants()) do
            if #objectives >= 50 then break end
            if (d:IsA("BasePart") or d:IsA("Model")) and not seen[d] and d.Name:lower():find("objective") then
                seen[d] = true
                table.insert(objectives, d)
            end
        end
    end
    return objectives
end

