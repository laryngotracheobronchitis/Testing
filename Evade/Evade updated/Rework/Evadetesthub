-- Invis Walls Collide (REKONSTRUKSI baris 8100-8137; default true seperti asli)
local invisWalls = { Cache = {}, Active = false, LoopId = 0 }

local function restoreInvisWalls()
    for part, original in pairs(invisWalls.Cache) do
        if part.Parent then
            pcall(function()
                part.CanCollide = original
            end)
        end
    end
    table.clear(invisWalls.Cache)
end

local function stopInvisWalls()
    invisWalls.Active = false
    restoreInvisWalls()
end

local function scanInvisWalls()
    local root = workspace:FindFirstChild("Map") or workspace -- hemat perf: scan Map dulu
    for _, part in ipairs(root:GetDescendants()) do
        if part:IsA("BasePart") and invisWalls.Cache[part] == nil then
            -- heuristik dinding tak terlihat: transparan penuh, anchored, solid
            if part.Transparency >= 0.99 and part.Anchored and part.CanCollide then
                invisWalls.Cache[part] = true
                pcall(function()
                    part.CanCollide = false
                end)
            end
        end
    end
end

Tabs.Utility:Toggle({
    Title = "Invis Walls Collide",
    Flag = "InvisWallsCollide",
    Desc = "OFF = tembus dinding tak terlihat (invisible walls). Default ON = perilaku normal game. (REKONSTRUKSI)",
    Value = true,
    Callback = function(state)
        if state then
            invisWalls.Active = false
            restoreInvisWalls()
        else
            invisWalls.Active = true
            invisWalls.LoopId = invisWalls.LoopId + 1
            local myLoop = invisWalls.LoopId
            task.spawn(function()
                while invisWalls.Active and invisWalls.LoopId == myLoop do
                    scanInvisWalls()
                    task.wait(3)
                end
            end)
        end
    end
})

