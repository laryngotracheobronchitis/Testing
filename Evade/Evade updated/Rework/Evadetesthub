local defaultMovementValues = {
SprintAcceleration = 1,
SprintCap = 2,
RunAccel = 1,
Friction = 5,
RunDeaccel = 700,
AirStrafeAcceleration = 182,
AirAcceleration = 1,
Speed = 1500,
