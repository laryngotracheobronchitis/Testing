local playerList = {}
function findWorkspaceCharacterForPlayer(plr) local playersFolder = workspace:FindFirstChild("Players"); if not playersFolder then return nil end; local byName = playersFolder:FindFirstChild(plr.Name); if byName and byName:IsA("Model") then return byName end; for _, model in ipairs(playersFolder:GetChildren()) do if model:IsA("Model") then local attrName = model:GetAttribute("Name"); local attrTag = model:GetAttribute("Tag"); local userId = model:GetAttribute("UserId") or model:GetAttribute("PlayerUserId"); if attrName == plr.Name or attrName == plr.DisplayName then return model end; if attrTag == plr.Name or attrTag == plr.DisplayName then return model end; if typeof(userId) == "number" and userId == plr.UserId then return model end; if model.Name == tostring(plr.UserId) then return model end end end; if plr.Character and plr.Character.Parent == playersFolder then return plr.Character end; return nil end
function getModelChildIndex(model) local parent = model and model.Parent; if not parent then return 0 end; for i, child in ipairs(parent:GetChildren()) do if child == model then return i end end; return 0 end
function updatePlayerList()
    playerList = {}; local dropdownValues = {}; local listedModels = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local model = findWorkspaceCharacterForPlayer(plr); local childIndex = model and getModelChildIndex(model) or 0
            table.insert(playerList, { player = plr, model = model, kind = "player", childIndex = childIndex })
            local title = plr.DisplayName; if model and childIndex > 0 then title = title .. " [ChildIndex:" .. tostring(childIndex) .. "]" end
            local iconUrl = "user"; local ok, thumb = pcall(function() return Players:GetUserThumbnailAsync(plr.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150) end); if ok and thumb then iconUrl = thumb end
            local desc = model and "Team: " .. tostring(model:GetAttribute("Team") or "Unknown") .. " | @" .. plr.Name .. " | Index:" .. tostring(childIndex) or "No Character Found | @" .. plr.Name
            if model then listedModels[model] = true end
            table.insert(dropdownValues, { Title = title, Desc = desc, Icon = iconUrl })
        end
    end
    local playersFolder = workspace:FindFirstChild("Players")
    if playersFolder then
        local myChar = LocalPlayer.Character; local myModel = findWorkspaceCharacterForPlayer(LocalPlayer)
        if myModel then listedModels[myModel] = true end; if myChar then listedModels[myChar] = true end
        for index, model in ipairs(playersFolder:GetChildren()) do
            if model:IsA("Model") and not listedModels[model] then
                local attrName = model:GetAttribute("Name"); local attrTag = model:GetAttribute("Tag"); local userId = model:GetAttribute("UserId") or model:GetAttribute("PlayerUserId")
                local isMe = (model.Name == LocalPlayer.Name) or (attrName == LocalPlayer.Name) or (attrName == LocalPlayer.DisplayName) or (attrTag == LocalPlayer.Name) or (typeof(userId) == "number" and userId == LocalPlayer.UserId) or (model.Name == tostring(LocalPlayer.UserId)) or (model == myChar) or (model == myModel)
                if not isMe then
                    local hrp = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChildWhichIsA("BasePart")
                    if hrp then
                        local team = model:GetAttribute("Team") or "Unknown"; local displayName = model:GetAttribute("Name") or model.Name
                        local iconUrl = "user"; if tostring(team) == "NPC" then local nbIcon = getNPCIcon(model); if nbIcon and nbIcon ~= "" then iconUrl = nbIcon end end
                        table.insert(playerList, { player = nil, model = model, kind = "character", childIndex = index })
                        table.insert(dropdownValues, { Title = tostring(displayName) .. " [ChildIndex:" .. tostring(index) .. "]", Desc = "Team: " .. tostring(team) .. " | " .. model.Name .. " | Index:" .. tostring(index), Icon = iconUrl })
                        listedModels[model] = true
                    end
                end
            end
        end
    end
    if #dropdownValues == 0 then dropdownValues = {{Title = "No players found", Desc = "", Icon = "user"}} end
    PlayerDropdown:Refresh(dropdownValues, true)
end
function getNPCIcon(model) local hrp = model:FindFirstChild("HumanoidRootPart"); if not hrp then return nil end; local billboard = hrp:FindFirstChild("BillboardGui"); if not billboard then return nil end; local icon = billboard:FindFirstChild("Icon"); if not icon then return nil end; if icon:IsA("ImageLabel") or icon:IsA("ImageButton") then return icon.Image end; return nil end

