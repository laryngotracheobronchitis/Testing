function SelfRevive:IsDowned()
    local charData = CharacterService:GetCharacterFromPlayer(LocalPlayer)
    if charData and charData.DataRegistry then
        return charData.DataRegistry:Get("Downed") == true
    end
    return false
end

-- REKONSTRUKSI: payload Interact untuk "Fake Revive" TIDAK terlihat di lampiran.
-- Verifikasi signature remote ini dengan file asli sebelum dipakai serius.
function SelfRevive:FakeRevive()
    local tag = GetCharacterTag(LocalPlayer.Character)
    if not tag then return false end
    local ok, err = pcall(function()
        Interact:FireServer("Revive", tag)
    end)
    if not ok then
        warn("[DaraHub] FakeRevive gagal: " .. tostring(err))
    end
    return ok
end

function SelfRevive:Spawnpoint()
    local cf = getSpawnCFrame()
    if not cf then
        warn("[DaraHub] Spawnpoint revive: spawn tidak ditemukan")
        return false
    end
    return teleportTo(cf)
end

function SelfRevive:ApplyMethod()
    if self.Method == "Fake Revive" then
        return self:FakeRevive()
    end
    return self:Spawnpoint()
end

function SelfRevive:Stop()
    self.Enabled = false
    if self.Connection then
        self.Connection:Disconnect()
        self.Connection = nil
    end
end

function SelfRevive:Start()
    self:Stop()
    self.Enabled = true
    self.Connection = RunService.Heartbeat:Connect(function()
        if not self.Enabled then return end
        if os.clock() - self.LastAttempt < 1 then return end -- debounce 1 detik
        if self:IsDowned() then
            self.LastAttempt = os.clock()
            self:ApplyMethod()
        end
    end)
end

