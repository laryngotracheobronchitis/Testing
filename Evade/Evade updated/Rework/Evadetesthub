local objectives = {}
local objectiveDropdown
local lastUpdateTime = 0
local updateCooldown = 1
function updateObjectiveDropdown()
    if tick() - lastUpdateTime < updateCooldown then return end; lastUpdateTime = tick(); objectives = getObjectives()
    if not objectiveDropdown then return end
    if #objectives > 0 then
        local objectiveNames = {}; for _, obj in ipairs(objectives) do if obj and obj.Name then table.insert(objectiveNames, obj.Name) end end
        if #objectiveNames > 0 then objectiveDropdown:Refresh(objectiveNames, objectiveNames[1]) else objectiveDropdown:Refresh({"No valid objectives"}, "No valid objectives") end
    else
        objectiveDropdown:Refresh({"No objectives found"}, "No objectives found")
    end
end
