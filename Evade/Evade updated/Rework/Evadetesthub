local SelfRevive = { Method = "Spawnpoint", Enabled = false, HasRevived = false, LastSavedPosition = nil, IsProcessing = false, LastRespawnTime = 0, Connections = { Heartbeat = nil, Character = nil } }

function SelfRevive:Respawn()
    local now = tick()
    if now - SelfRevive.LastRespawnTime < 0.5 then return end
    SelfRevive.LastRespawnTime = now
    if SelfRevive.IsProcessing then return end
    local char = LocalPlayer.Character
    if not char then return end
    local charData = CharacterService:GetCharacterFromPlayer(LocalPlayer)
    local isDowned = charData and charData.DataRegistry:Get("Downed")
    if not isDowned then return end
    SelfRevive.IsProcessing = true
    local hrp = char:FindFirstChild("HumanoidRootPart")
    
    if SelfRevive.Method == "Spawnpoint" then
        if not SelfRevive.HasRevived then
            self.HasRevived = true
            pcall(function() changePlayerMode:FireServer(true) end)
            SelfRevive.IsProcessing = false
            task.delay(10, function() self.HasRevived = false end)
        else
            SelfRevive.IsProcessing = false
        end
    elseif self.Method == "Fake Revive" then
        local savedPos = hrp and hrp.CFrame.Position
        task.spawn(function()
            pcall(function() changePlayerMode:FireServer(true) end)
            local newCharacter
            repeat newCharacter = LocalPlayer.Character task.wait() until newCharacter and newCharacter:FindFirstChild("HumanoidRootPart") and newCharacter ~= char
            if newCharacter then
                local newHRP = newCharacter:FindFirstChild("HumanoidRootPart")
                if savedPos and newHRP then task.wait(0.1) newHRP.CFrame = CFrame.new(savedPos) end
            end
            SelfRevive.IsProcessing = false
        end)
    else
        SelfRevive.IsProcessing = false
    end
end

function SelfRevive:Start()
    if SelfRevive.Connections.Heartbeat then return end
    SelfRevive.Enabled = true
    SelfRevive.Connections.Heartbeat = RunService.Heartbeat:Connect(function()
        if not SelfRevive.Enabled then return end
        local char = LocalPlayer.Character
        if not char then return end
        local charData = CharacterService:GetCharacterFromPlayer(LocalPlayer)
        if charData and charData.DataRegistry:Get("Downed") then self:Respawn() end
    end)
    SelfRevive.Connections.Character = LocalPlayer.CharacterAdded:Connect(function(newChar)
        SelfRevive.HasRevived = false; SelfRevive.IsProcessing = false; SelfRevive.LastSavedPosition = nil
    end)
end

function SelfRevive:Stop()
    SelfRevive.Enabled = false; SelfRevive.HasRevived = false; SelfRevive.IsProcessing = false; SelfRevive.LastSavedPosition = nil
    for name, conn in pairs(SelfRevive.Connections) do if conn then conn:Disconnect() SelfRevive.Connections[name] = nil end end
end

