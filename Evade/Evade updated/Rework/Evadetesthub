-- CLEANUP — dipanggil saat window dihancurkan (anti kebocoran connection)
-- =========================================================
local function cleanup()
    if bounceConnection then
        bounceConnection:Disconnect()
        bounceConnection = nil
    end
    if stopRampBooster then stopRampBooster() end
    SelfRevive:Stop()
    stopInvisWalls()
    if jumpPadHooked then
        pcall(function()
            JumpPadModule.Use = originalJumpPadUse
        end)
        jumpPadHooked = false
        originalJumpPadUse = nil
    end
    for key in pairs(forceVisibleTasks) do
        stopForceVisible(key)
    end
    stopStatsOverlay()
    for _, state in pairs(shopStates) do
        state.AutoBuySelected = false
        state.AutoBuyAll = false
        state.Running = false
    end
    if MobileTopbar.UpdateAllButtons then
        pcall(MobileTopbar.UpdateAllButtons) -- lepas semua keybind yang tertahan
    end
    ButtonLib:DestroyScreengui()
    mouseUnlock(false)
end

if typeof(Window.OnDestroy) == "function" then
    Window:OnDestroy(function()
        cleanup()
    end)
elseif Window.OnDestroy and typeof(Window.OnDestroy.Connect) == "function" then
    Window.OnDestroy:Connect(function()
        cleanup()
    end)
else
    warn("[DaraHub] Window.OnDestroy tidak tersedia di WindUI ini — matikan toggle manual sebelum re-execute.")
end
