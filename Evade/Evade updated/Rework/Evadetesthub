function getObjectives() local objectives = {}; local gameFolder = workspace:FindFirstChild("Game"); if not gameFolder then return objectives end; local mapFolder = gameFolder:FindFirstChild("Map"); if not mapFolder then return objectives end; local partsFolder = mapFolder:FindFirstChild("Parts"); if not partsFolder then return objectives end; local objectivesFolder = partsFolder:FindFirstChild("Objectives"); if not objectivesFolder then return objectives end; for _, obj in pairs(objectivesFolder:GetChildren()) do if obj:IsA("Model") then local primaryPart = obj.PrimaryPart; if not primaryPart then for _, part in pairs(obj:GetChildren()) do if part:IsA("BasePart") then primaryPart = part; break end end end; if primaryPart then table.insert(objectives, { Name = obj.Name, Part = primaryPart, Position = primaryPart.Position, Size = primaryPart.Size }) end end end; return objectives end
function teleportToObjective(objectiveName, offset) local objectives = getObjectives(); for _, obj in ipairs(objectives) do if obj.Name == objectiveName then local teleportPosition = obj.Position + offset; local raycastParams = RaycastParams.new(); local char = LocalPlayer.Character; if char then raycastParams.FilterDescendantsInstances = {char} end; raycastParams.FilterType = Enum.RaycastFilterType.Blacklist; local ray = workspace:Raycast(teleportPosition, Vector3.new(0, -10, 0), raycastParams); if ray then teleportPosition = ray.Position + Vector3.new(0, 3, 0) end; teleportToCFrame(CFrame.new(teleportPosition)); return end end end

