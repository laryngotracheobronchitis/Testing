-- TAB SHOP (REKONSTRUKSI baris 9112-9948)
-- Struktur & loop lengkap; getShopStock/purchaseItem/canAfford = best-effort
-- dan WAJIB disesuaikan dengan file asli.
-- =========================================================
local shopStates = {}

-- Hook currency game (path dari blok require file asli) — best-effort, pcall
local useCurrencyHook
pcall(function()
    useCurrencyHook = require(ReplicatedStorage.Shared.UserData.ClientHooks.useCurrency)
end)

local function canAfford(item)
    -- REKONSTRUKSI: kalau saldo tidak bisa dicek, kembalikan true (server memvalidasi juga)
    if type(useCurrencyHook) ~= "function" then return true end
    local ok, res = pcall(useCurrencyHook)
    if not ok then return true end
    local balance = nil
    if type(res) == "number" then
        balance = res
    elseif type(res) == "table" then
        if type(res.Tokens) == "number" then
            balance = res.Tokens
        elseif type(res.Value) == "number" then
            balance = res.Value
        elseif type(res.Get) == "function" then
            local ok2, v = pcall(function() return res:Get() end)
            if ok2 and type(v) == "number" then balance = v end
        end
    end
    local price = item.Cost and item.Cost.Amount
    if type(balance) == "number" and type(price) == "number" then
        return balance >= price
    end
    return true
end

-- REKONSTRUKSI: enumerasi item ber-harga dari ReplicatedStorage.Items (heuristik)
local function getCostInfo(itemData)
    if type(itemData) ~= "table" then return nil end
    local cost = itemData.Cost or itemData.Price or (itemData.Info and itemData.Info.Cost)
    if type(cost) == "number" then
        return { Amount = cost, Currency = nil, Multiple = false }
    elseif type(cost) == "table" then
        return {
            Amount = cost.Amount or cost.Price,
            Currency = cost.Currency or cost.Type,
            Multiple = type(cost.Currencies) == "table" or type(cost.Options) == "table",
        }
    end
    return nil
end

local function enumeratePurchasableItems()
    local list = {}
    local itemsFolder = ReplicatedStorage:FindFirstChild("Items")
    if itemsFolder then
        for _, child in ipairs(itemsFolder:GetChildren()) do
            if child:IsA("ModuleScript") then
                local ok, data = pcall(require, child)
                if ok and type(data) == "table" then
                    local cost = getCostInfo(data)
                    if cost then
                        table.insert(list, {
                            Name = data.Name or child.Name,
                            ModuleName = child.Name,
                            Data = data,
                            Cost = cost,
                        })
                    end
                end
            end
        end
    end
    table.sort(list, function(a, b) return a.Name:lower() < b.Name:lower() end)
    return list
end

-- REKONSTRUKSI: filter per-shop — SESUAIKAN dengan file asli!
local function matchesShop(item, shopType)
    local data, currency = item.Data, item.Cost.Currency
    if shopType == "Token Shop" then
        return currency == "Tokens" or currency == "Token"
    elseif shopType == "Multiple Type Items" then
        return item.Cost.Multiple == true
    elseif shopType == "Event Shop" then
        return data.Event ~= nil or data.IsEvent == true or currency == "Tickets"
    elseif shopType == "Daily Shop" then
        return data.Daily == true or data.Shop == "Daily"
    end
    return false
end

local function getShopStock(shopType)
    local stock = {}
    for _, item in ipairs(enumeratePurchasableItems()) do
        if matchesShop(item, shopType) then
            table.insert(stock, item)
        end
    end
    if #stock == 0 then
        warn("[DaraHub] Filter stok '" .. shopType .. "' kosong — fallback ke semua item ber-harga. Perbaiki matchesShop() sesuai file asli.")
        stock = enumeratePurchasableItems()
    end
    return stock
end

-- REKONSTRUKSI: remote pembelian asli tidak terlihat di lampiran.
-- Coba kandidat remote umum; kalau tidak ada → warn sekali dan loop jadi no-op.
local purchaseRemoteWarned = false
local function purchaseItem(item)
    local events = ReplicatedStorage:FindFirstChild("Events")
    if events then
        for _, remoteName in ipairs({ "PurchaseItem", "BuyItem", "ShopPurchase" }) do
            local remote = events:FindFirstChild(remoteName)
            if remote and remote:IsA("RemoteEvent") then
                local ok, err = pcall(function()
                    remote:FireServer(item.ModuleName)
                end)
                if not ok then
                    warn("[DaraHub] purchaseItem gagal: " .. tostring(err))
                end
                return ok
            end
        end
    end
    if not purchaseRemoteWarned then
        purchaseRemoteWarned = true
        warn("[DaraHub] Remote pembelian shop tidak ditemukan — isi purchaseItem() di TAB SHOP sesuai file asli (baris 9112-9948).")
    end
    return false
end

local function buildShopSection(shopTitle)
    local key = shopTitle:gsub("%s", "")
    local state = {
        Selected = nil,
        Stock = {},
        AutoBuySelected = false,
        AutoBuyAll = false,
        Running = false,
        Attempted = {}, -- anti rebuy: tiap item hanya dicoba sekali per sesi toggle
        Dropdown = nil,
    }
    shopStates[key] = state

    Tabs.Shop:Section({ Title = shopTitle, TextSize = shopTitle == "Multiple Type Items" and 16 or 20 })

    state.Dropdown = Tabs.Shop:Dropdown({
        Title = shopTitle .. " Items",
        Flag = "Shop" .. key .. "Items",
        Values = { "(memuat...)" },
        Value = "(memuat...)",
        Callback = function(value)
            state.Selected = value
        end
    })

    local function refreshStock()
        state.Stock = getShopStock(shopTitle)
        local names = {}
        for _, item in ipairs(state.Stock) do
            table.insert(names, item.Name)
        end
        safeRefreshDropdown(state.Dropdown, names, names[1])
        if #names == 0 then
            WindUI:Notify({ Title = shopTitle, Content = "Stok tidak ditemukan — cek console.", Duration = 4 })
        end
    end
    refreshStock()

    local function startLoop()
        if state.Running then return end
        state.Running = true
        task.spawn(function()
            -- loop berhenti bersih saat kedua toggle OFF (kondisi dicek tiap iterasi)
            while state.Running and (state.AutoBuySelected or state.AutoBuyAll) do
                if state.AutoBuyAll then
                    for _, item in ipairs(state.Stock) do
                        if not state.Running or not state.AutoBuyAll then break end
                        if not state.Attempted[item.ModuleName] then
                            state.Attempted[item.ModuleName] = true
                            if canAfford(item) then
                                purchaseItem(item)
                            end
                            task.wait(0.4)
                        end
                    end
                elseif state.AutoBuySelected and state.Selected then
                    for _, item in ipairs(state.Stock) do
                        if item.Name == state.Selected then
                            if canAfford(item) then
                                purchaseItem(item)
                            end
                            break
                        end
                    end
                end
                task.wait(2)
            end
            state.Running = false
        end)
    end

    Tabs.Shop:Toggle({
        Title = "Auto Buy Selected",
        Flag = "Shop" .. key .. "AutoBuySelected",
        Value = false,
        Callback = function(v)
            state.AutoBuySelected = v
            if v then
                state.Attempted = {}
                startLoop()
            end
        end
    })

    Tabs.Shop:Toggle({
        Title = "Auto Buy All",
        Flag = "Shop" .. key .. "AutoBuyAll",
        Value = false,
        Callback = function(v)
            state.AutoBuyAll = v
            if v then
                state.Attempted = {}
                startLoop()
            end
        end
    })
end

