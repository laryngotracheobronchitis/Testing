-- Jump Pad Bounce Modifier (REKONSTRUKSI baris 8286-8328)
local JumpPadValue = 360
local originalJumpPadUse = nil
local jumpPadHooked = false

local function findRootFromArgs(...)
    local n = select("#", ...)
    for i = 1, n do
        local v = select(i, ...)
        if typeof(v) == "Instance" then
            if v:IsA("BasePart") and v.Name == "HumanoidRootPart" then
                return v
            elseif v:IsA("Model") then
                local hrp = v:FindFirstChild("HumanoidRootPart")
                if hrp then return hrp end
            elseif v:IsA("Player") and v.Character then
                local hrp = v.Character:FindFirstChild("HumanoidRootPart")
                if hrp then return hrp end
            end
        elseif type(v) == "table" and typeof(v.Character) == "Instance" then
            local hrp = v.Character:FindFirstChild("HumanoidRootPart")
            if hrp then return hrp end
        end
    end
    return nil
end

Tabs.Utility:Toggle({
    Title = "Jump Pad Bounce Modifier",
    Flag = "JumpPadBounceModifier",
    Desc = "Override JumpPadModule.Use dengan ApplyImpulse(0, Jump Value, 0). (REKONSTRUKSI)",
    Value = false,
    Callback = function(state)
        if state then
            if not jumpPadHooked then
                local ok, err = pcall(function()
                    originalJumpPadUse = JumpPadModule.Use
                    JumpPadModule.Use = function(...)
                        local rootPart = findRootFromArgs(...)
                        if rootPart then
                            pcall(function()
                                rootPart:ApplyImpulse(Vector3.new(0, JumpPadValue, 0))
                            end)
                        end
                    end
                end)
                if ok then
                    jumpPadHooked = true
                else
                    warn("[DaraHub] Gagal hook JumpPadModule.Use (mungkin read-only): " .. tostring(err))
                end
            end
        else
            if jumpPadHooked then
                pcall(function()
                    JumpPadModule.Use = originalJumpPadUse
                end)
                originalJumpPadUse = nil
                jumpPadHooked = false
            end
        end
    end
})

