-- =========================================================
-- ButtonLib mini — pengganti library DaraHub (tidak dipakai bersama WindUI resmi)
-- API: ButtonLib.Create:Button / Create:Toggle, obj:SetVisible/SetText/Set,
--      ButtonLib[Flag] = obj, ButtonLib:DestroyScreengui()
-- =========================================================
local ButtonLib = {}
do
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "DaraHubButtons"
    screenGui.DisplayOrder = 999
    screenGui.ResetOnSpawn = false
    screenGui.IgnoreGuiInset = true

    pcall(function()
        screenGui.Parent = CoreGui
    end)
    if not screenGui.Parent then
        screenGui.Parent = PlayerGui
    end
    ButtonLib.ScreenGui = screenGui

    local function createButtonInstance(config)
        local btn = Instance.new("TextButton")
        btn.Name = config.Text or "DaraHubButton"
        btn.Size = UDim2.new(0, 250, 0, 38)
        btn.Position = config.Position or UDim2.new(0.5, -125, 0.5, 0)
        btn.BackgroundColor3 = Color3.fromRGB(28, 28, 34)
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.Font = Enum.Font.GothamBold
        btn.TextSize = 14
        btn.Text = config.Text or "Button"
        btn.AutoButtonColor = true
        btn.Visible = config.Visible == true
        btn.Parent = screenGui

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 8)
        corner.Parent = btn

        local stroke = Instance.new("UIStroke")
        stroke.Color = Color3.fromRGB(60, 60, 70)
        stroke.Transparency = 0.4
        stroke.Parent = btn

        return btn
    end

    local function baseObject(btn)
        local obj = { Instance = btn }
        function obj:SetVisible(v)
            btn.Visible = v and true or false
        end
        function obj:SetText(t)
            btn.Text = tostring(t)
        end
        function obj:Destroy()
            btn:Destroy()
        end
        return obj
    end

    function ButtonLib.Create:Button(config)
        local btn = createButtonInstance(config)
        local obj = baseObject(btn)
        btn.MouseButton1Click:Connect(function()
            if type(config.Callback) == "function" then
                config.Callback()
            end
        end)
        if config.Flag then ButtonLib[config.Flag] = obj end
        return obj
    end

    function ButtonLib.Create:Toggle(config)
        local btn = createButtonInstance(config)
        local obj = baseObject(btn)
        obj._state = config.Default == true

        local function applyVisual()
            btn.BackgroundColor3 = obj._state
                and Color3.fromRGB(40, 160, 80)
                or Color3.fromRGB(28, 28, 34)
        end
        applyVisual()

        -- Set = ubah visual/state saja, TIDAK memanggil Callback (anti loop)
        function obj:Set(v)
            obj._state = v and true or false
            applyVisual()
        end

        btn.MouseButton1Click:Connect(function()
            obj:Set(not obj._state)
            if type(config.Callback) == "function" then
                config.Callback(obj._state)
            end
        end)

        if config.Flag then ButtonLib[config.Flag] = obj end
        return obj
    end

    function ButtonLib:DestroyScreengui()
        if screenGui then screenGui:Destroy() end
    end
end

