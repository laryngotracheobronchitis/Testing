local forceVisibleTasks = {}

local function stopForceVisible(key)
    local entry = forceVisibleTasks[key]
    if entry then
        entry.Active = false -- thread akan restore kondisi awal & berhenti sendiri
    end
end

local function startForceVisible(key, guiNames)
    stopForceVisible(key)
    local entry = { Active = true, Cache = {} }
    forceVisibleTasks[key] = entry

    task.spawn(function()
        while entry.Active do
            for _, inst in ipairs(PlayerGui:GetDescendants()) do
                for _, name in ipairs(guiNames) do
                    if inst.Name == name then
                        pcall(function()
                            if entry.Cache[inst] == nil then
                                entry.Cache[inst] = (inst:IsA("ScreenGui") and inst.Enabled)
                                    or (inst:IsA("GuiObject") and inst.Visible) or false
                            end
                            if inst:IsA("ScreenGui") then
                                inst.Enabled = true
                            elseif inst:IsA("GuiObject") then
                                inst.Visible = true
                            end
                        end)
                    end
                end
            end
            task.wait(0.5)
        end
        -- OFF: pulihkan kondisi awal yang tersimpan
        for inst, original in pairs(entry.Cache) do
            pcall(function()
                if inst.Parent then
                    if inst:IsA("ScreenGui") then
                        inst.Enabled = original
                    elseif inst:IsA("GuiObject") then
                        inst.Visible = original
                    end
                end
            end)
        end
        if forceVisibleTasks[key] == entry then
            forceVisibleTasks[key] = nil
        end
    end)
end

