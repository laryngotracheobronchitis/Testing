local function MovementValueSet(MovementType, value)
    if not CharacterTag then
        CharacterTag = GetCharacterTag(LocalPlayer.Character)
    end
    if CharacterTag then
        FireClient(ReplicatedStorage.Events.CharacterTask, CharacterTag, "ModifyMovement", {MovementType, value})
