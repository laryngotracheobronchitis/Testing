function getModuleSource(module)
local src = nil
if decompile then
local ok, result = pcall(decompile, module)
if ok and type(result) == "string" then
src = result
end
end
if not src then
local ok, result = pcall(function()
return module.Source
end)
if ok and type(result) == "string" then
src = result
end
end
return src
end

function npcHasEventReward(module)
local cached = module:GetAttribute("CatchRewarded")
if cached ~= nil then
return cached
end
local src = getModuleSource(module)
local rewarded = src ~= nil and src:find("require%(%w+%.Services%.UserData%.EventService%)") ~= nil
pcall(module.SetAttribute, module, "CatchRewarded", rewarded)
return rewarded
end

