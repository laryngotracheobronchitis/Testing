-- ADD (UPDATE BETA): AUTO REVIVE - port dari DaraHub BETA (tab Auto).
-- Menembak Interact "Revive" ke semua model di Workspace.Players dalam range,
-- dengan Auto Revive Delay (jeda per target, default 1.17 detik - persis Beta).
-- ============================================================
Tabs.Auto:Space()
do
local autoReviveEnabled = false
local autoReviveDelay = 1.17
local autoReviveRange = 15
local autoReviveDownedCheck = false
local autoReviveConnection = nil
local lastRevive = setmetatable({}, { __mode = "k" })

-- helper lokal (versi Ringkas menaruh helper ini lokal di blok Defib, jadi dibuat lagi di sini)
local function autoReviveGetStatus(player)
local character = player.Character
if not character then
return "DEAD"
end
local charData = nil
pcall(function()
charData = CharacterService and CharacterService:GetCharacterFromPlayer(player)
end)
if charData and charData.DataRegistry and charData.DataRegistry:Get("Downed") then
return "DOWNED"
end
local humanoid = character:FindFirstChildOfClass("Humanoid")
if humanoid and humanoid.Health > 0 then
return "ALIVE"
end
return "DEAD"
end
local function autoReviveIsPlayerDowned(player)
return autoReviveGetStatus(player) == "DOWNED"
end
local function autoReviveIsModelDowned(model)
if not model or not model:IsA("Model") then
return false
end
local humanoid = model:FindFirstChild("Humanoid")
if humanoid and humanoid.Health <= 0 then
return true
end
return false
end

local function stopAutoRevive()
autoReviveEnabled = false
if autoReviveConnection then
autoReviveConnection:Disconnect()
autoReviveConnection = nil
end
table.clear(lastRevive)
end

local function startAutoRevive()
stopAutoRevive()
autoReviveEnabled = true
-- FIX (FPS): Beta memindai TIAP FRAME (60x/detik) -> di-throttle 10x/detik (0.1s);
-- jeda antar fire tetap diatur Auto Revive Delay sehingga hasil sama, beban turun ~6x.
local scanAcc = 0
autoReviveConnection = RunService.Heartbeat:Connect(function(dt)
if not autoReviveEnabled then
return
end
scanAcc = scanAcc + dt
if scanAcc < 0.1 then return end
scanAcc = 0
local folder = workspace:FindFirstChild("Players")
local ownCharacter = LocalPlayer.Character
local ownRoot = ownCharacter and ownCharacter:FindFirstChild("HumanoidRootPart")
if not folder or not ownRoot then
return
end
local now = os.clock()
for _, model in ipairs(folder:GetChildren()) do
if model:IsA("Model") and model ~= ownCharacter then
local tag = model:GetAttribute("Tag")
local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
local is_downed_target = true
if autoReviveDownedCheck then
local plr = Players:GetPlayerFromCharacter(model)
is_downed_target = (plr ~= nil and autoReviveIsPlayerDowned(plr)) or autoReviveIsModelDowned(model)
end
if tag ~= nil and root and is_downed_target and now - (lastRevive[model] or 0) >= autoReviveDelay then
if autoReviveRange == math.huge or (ownRoot.Position - root.Position).Magnitude <= autoReviveRange then
lastRevive[model] = now
pcall(function()
Interact:FireServer("Revive", tag)
Interact:FireServer("Revive", tag, true)
end)
end
end
end
end
end)
end

