end
end)
end
break
end
end
end
end)

if okInt and eatRemote then
return
end
end

return oldNamecall(self, ...)
end)
end)
pcall(function()
setreadonly(gmt, true)
end)

if okHook then
isColaHooked = true
else
warn("[Dara Hub] Gagal memasang hook Cola: " .. tostring(hookErr))
end
end

local function removeColaHook()
if not isColaHooked then return end

pcall(function()
setreadonly(gmt, false)
gmt.__namecall = oldNamecall
setreadonly(gmt, true)
end)

isColaHooked = false
end

