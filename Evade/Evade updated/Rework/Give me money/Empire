SelfRevive.Enabled = true
-- FIX (Task 18): loop sebelumnya memanggil service GetCharacterFromPlayer TANPA pcall
-- TIAP FRAME (60x/detik) - bila service nil/berubah path, error spam tiap frame = FPS drop.
