return nil
end
local valid = {}
for _, model in ipairs(playersFolder:GetChildren()) do
if isValidTokenFarmTarget(model) then
table.insert(valid, model)
end
end
if #valid == 0 then
return nil
end
return valid[math.random(1, #valid)]
end

