-- ADD: helper baca input angka - INPUT KOSONG / BUKAN ANGKA = OTOMATIS PAKAI DEFAULT (permintaan user).
function parseNumberInput(value, default)
if value == nil then return default end
if type(value) == "number" then return value end
local trimmed = tostring(value):gsub("^%s+", ""):gsub("%s+$", "")
if trimmed == "" then return default end
local n = tonumber(trimmed)
if n == nil then return default end
return n
end

-- ADD: helper FireClient yang aman - event dicari dengan FindFirstChild dulu (tidak pernah error bila path berubah)
function SafeFireEvent(eventsParent, eventName, ...)
local ev = eventsParent and eventsParent:FindFirstChild(eventName)
if not ev then
return false
end
return FireClient(ev, ...)
end



-- FIX (Task 19): FireClient kini kompatibel dengan varian API getconnections antar
-- executor PC (c.Function bisa nil / akses properti bisa melempar error / sebagian
-- executor hanya menyediakan c:Fire). Sebelumnya c.Function(...) dipanggil mentah,
-- sehingga di banyak executor PC error terjadi diam-diam di dalam task.spawn dan nilai
-- tidak pernah terkirim: itulah sebabnya Jump Cap & Air Strafe Acceleration (yang 100%
-- bergantung jalur ini) tidak bekerja di PC, sementara Bhop/Super Bounce tetap jalan
-- karena murni client-side. Mengembalikan true bila minimal satu koneksi berhasil
-- dipicu (dipakai MovementValueSet untuk memutuskan fallback jalur langsung).
-- FIX (Task 19): helper VARARG - '...' tidak boleh dipakai di dalam closure non-vararg
-- (varian pertama patch ini memicu parse error "cannot use '...' outside a vararg function"
-- yang membuat seluruh script gagal dimuat; ditangkap oleh simulator runtime).
local function tryFireConnection(c, ...)
local okFn, fn = pcall(function() return c.Function end)
if okFn and type(fn) == "function" then
if pcall(fn, ...) then
return true
end
-- FIX (Task 20): kalau pemanggilan Function gagal (mis. handler game yield tetapi
-- pcall executor tidak mendukung yield), coba c:Fire yang menjalankan callback
-- di thread tersendiri.
end
local okFire, fireMethod = pcall(function() return c.Fire end)
if okFire and type(fireMethod) == "function" then
return pcall(fireMethod, c, ...)
end
return false
end

local fireClientWarned = false
function FireClient(path, ...)
if not getconnections then
if not fireClientWarned then
fireClientWarned = true
warn("[Dara Hub] Executor tidak mendukung 'getconnections' - nilai movement dikirim via jalur langsung")
end
return false
end
local okConns, conns = pcall(getconnections, path.OnClientEvent)
if not okConns or conns == nil then
return false
end
-- FIX (Task 20): JANGAN menolak hasil getconnections berdasarkan type/isi. Versi
-- sebelumnya menolak type ~= "table" dan #conns == 0 - di sebagian executor PC
-- getconnections mengembalikan wrapper (bukan table murni) sehingga seluruh jalur
-- ini mati: BhopEnabled/Friction tidak pernah terkirim (bhop mati, gerakan & kamera
-- terasa kaku), padahal di v1.2.3 dan sebelumnya jalur yang sama bekerja normal.
-- Argumen dibungkus table agar loop boleh berada di dalam pcall (closure non-vararg
-- tidak boleh memakai '...').
local nargs = select("#", ...)
local args = {}
for k = 1, nargs do
args[k] = select(k, ...)
end
local unpackFn = table.unpack or unpack
local fired = false
local iterated = false
-- Strategi 1: table / userdata dengan __index (ipairs)
pcall(function()
for _, c in ipairs(conns) do
iterated = true
if tryFireConnection(c, unpackFn(args, 1, nargs)) then
fired = true
end
end
end)
-- Strategi 2: fungsi iterator / userdata callable (varian executor PC)
if not iterated and type(conns) ~= "table" then
pcall(function()
for _, c in conns, nil, nil do
iterated = true
if tryFireConnection(c, unpackFn(args, 1, nargs)) then
fired = true
end
end
end)
end
-- Strategi 3: pairs (varian tersisa); flag 'iterated' mencegah fire ganda
if not iterated then
pcall(function()
for _, c in pairs(conns) do
iterated = true
if tryFireConnection(c, unpackFn(args, 1, nargs)) then
fired = true
end
end
end)
end
return fired
end
