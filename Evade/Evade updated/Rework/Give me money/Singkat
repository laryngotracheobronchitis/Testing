-- nilai yang benar-benar aktif di game. Game me-reset data movement ke default pada momen
-- tertentu (respawn / ganti round / dll) -> selama jeda sampai 2 detik nilai berada di
-- default -> baru dikirim ulang -> terasa seperti bolak-balik "default -> input" terus-menerus.
-- SISTEM BARU (desain yang diminta user): loop MEMERIKSA nilai ASLI di tabel Movement game:
--   * nilai SUDAH sesuai input & sudah masuk  -> TIDAK ADA yang dikirim (abaikan, nol event);
--   * nilai KEMBALI ke default / tidak sesuai -> kirim ulang SEKALI -> diperiksa lagi pada
--     tick berikutnya -> selesai (tidak kirim terus-menerus).
-- Jalur pengiriman & data TETAP PERSIS DARAHUB ASLI (MovementValueSet -> FireClient
-- CharacterTask "ModifyMovement" {MovementType, value}) - watchdog hanya MEMBACA tabel.
-- REGISTRI NILAI USER: hanya diisi dari callback INPUT section Modification (bukan dari
-- logika internal bhop) agar watchdog tahu "nilai yang diinginkan user" tanpa saling menimpa.
local userMovementValues = {}
-- daftar jenis nilai movement yang dijaga watchdog (EDISI FITUR TERPILIH: hanya Jump Cap & Air Strafe)
local smartMovementTypes = {
"JumpCap", "AirStrafeAcceleration"
}
local smartRefreshNextSend = {} -- [jenis] = waktu paling cepat kirim ulang berikutnya (cooldown anti spam)
local smartRefreshBlindNext = {} -- [jenis] = waktu kirim-but berikutnya (HANYA saat tabel tak terbaca)
local SMART_REFRESH_INTERVAL = 0.15 -- seberapa sering MEMERIKSA (baca tabel = sangat murah, tanpa kirim)
local SMART_RESEND_COOLDOWN = 0.5 -- jeda minimum antar kirim ulang per jenis (saat game me-reset berulang)
local SMART_BLIND_INTERVAL = 2 -- fallback perilaku lama (kirim-but 2 dtk) HANYA bila tabel tak terbaca
local smartGetCharacterFn = CharacterService and CharacterService.GetCharacterFromPlayer

local function smartRefreshInScope(mtype)
if autoRefreshAllMovement then return true end
if mtype == "JumpCap" and autoRefreshJumpCap then return true end
if mtype == "AirStrafeAcceleration" and autoRefreshAirStrafe then return true end
return false
end

-- Satu pass pemeriksaan watchdog: forceType = nil -> periksa SEMUA jenis; "JumpCap" dll -> hanya jenis itu.
-- Murni MEMBACA tabel Movement game + membandingkan; pengiriman hanya lewat MovementValueSet
-- (jalur asli DaraHub) dan HANYA saat nilai di game tidak sesuai keinginan user.
local function SmartMovementRefresh(forceType)
if next(userMovementValues) == nil then return end
local now = os.clock()
-- ambil tabel Movement LIVE milik game sekali per pass (baca = murah, tidak mengubah apa pun)
local movement = nil
if smartGetCharacterFn then
local okC, data = pcall(smartGetCharacterFn, CharacterService, LocalPlayer)
movement = (okC and data) and data.Movement or nil
end
if not movement then
movement = cachedMovementData
end
for _, mtype in ipairs(smartMovementTypes) do
if forceType == nil or mtype == forceType then
local desired = userMovementValues[mtype]
if desired ~= nil and smartRefreshInScope(mtype) then
if mtype == "Friction" and lastFriction ~= nil then
-- Bhop Acceleration sedang memegang Friction (override aktif) -> jangan diganggu;
-- saat bhop berhenti, hook movement mengembalikan Friction sendiri ke customFriction/default.
elseif movement then
local current = movement[mtype]
if type(current) == "number" and current == desired then
smartRefreshNextSend[mtype] = nil -- SUDAH SESUAI & SUDAH MASUK -> ABAIKAN (nol pengiriman)
elseif now >= (smartRefreshNextSend[mtype] or 0) then
smartRefreshNextSend[mtype] = now + SMART_RESEND_COOLDOWN
pcall(MovementValueSet, mtype, desired) -- ke-reset / beda -> kirim ulang SEKALI
-- periksa lagi pada tick berikutnya: bila sudah masuk -> tidak ada yang dikirim lagi
end
else
-- tabel Movement tidak terbaca -> fallback perilaku lama: kirim-but tiap 2 detik
if now >= (smartRefreshBlindNext[mtype] or 0) then
smartRefreshBlindNext[mtype] = now + SMART_BLIND_INTERVAL
pcall(MovementValueSet, mtype, desired)
end
end
end
end
end
end

