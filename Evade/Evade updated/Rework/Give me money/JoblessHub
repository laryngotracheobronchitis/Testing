EdgeTrimpToggle.Callback = function(State)
	ConfigState.EdgeTrimpEnabled = State
	if State then
		if LocalPlayer.Character then
			handleCharacterAdded(LocalPlayer.Character)
		end
		ConfigState.charAddedConnection = LocalPlayer.CharacterAdded:Connect(handleCharacterAdded)
		ConfigState.edgeTrimpConnection = RunService.Heartbeat:Connect(function()
			if not (Character and Humanoid and RootPart) then
				return
			end
			local CurrentPosition = RootPart.Position
			local Velocity = (CurrentPosition - ConfigState.LastPosition) / RunService.Heartbeat:Wait()
			ConfigState.LastPosition = CurrentPosition
			local CurrentFloorMaterial = Humanoid.FloorMaterial
			local IsFalling = Humanoid:GetState() == Enum.HumanoidStateType.Freefall or Humanoid:GetState() == Enum.HumanoidStateType.Jumping
			if CurrentFloorMaterial ~= ConfigState.LastFloorMaterial and CurrentFloorMaterial == Enum.Material.Air and not IsFalling then
				ConfigState.EdgeDetected = true
			else
				ConfigState.EdgeDetected = false
			end
			if ConfigState.EdgeDetected and Humanoid:GetState() ~= Enum.HumanoidStateType.Freefall then
				local FallVelocity = Velocity.Y
				if FallVelocity < - ConfigState.FallSpeedThreshold then
					local BounceVelocity = math.abs(FallVelocity) * ConfigState.BounceMultiplier
					RootPart.Velocity = Vector3.new(RootPart.Velocity.X, BounceVelocity, RootPart.Velocity.Z)
				end
			end
			ConfigState.LastFloorMaterial = CurrentFloorMaterial
			ConfigState.WasFalling = IsFalling
		end)
	else
		if ConfigState.edgeTrimpConnection then
			ConfigState.edgeTrimpConnection:Disconnect()
			ConfigState.edgeTrimpConnection = nil
		end
		if ConfigState.charAddedConnection then
			ConfigState.charAddedConnection:Disconnect()
