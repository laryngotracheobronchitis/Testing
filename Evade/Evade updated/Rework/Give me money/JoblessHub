ConfigState.isLagActive = false
ConfigState.lagSystemLoaded = false
function lag()
	local duration = ConfigState.lagDuration or 0.5
	local method = ConfigState.lagMethod or "CPU Cycle"
	if method == "CPU Cycle" then
		pcall(setfflag, "MaxMissedWorldStepsRemembered", "1")
		local start = tick()
		local function spin()
			if tick() - start >= duration then
				return
			end
			local a = math.random(1, 1000000) * math.random(1, 1000000)
			a = a / math.random(1, 10000)
			return spin()
		end
		spin()
	elseif method == "OS.ClockFFlag" then
		pcall(setfflag, "MaxMissedWorldStepsRemembered", "10000001000000")
		local start = os.clock()
		local function spin()
			if os.clock() - start < duration then
				return spin()
			end
		end
		spin()
	end
end
function loadLagSystem()
	if ConfigState.lagSystemLoaded then
		return
	end
	ConfigState.lagSystemLoaded = true
end
function unloadLagSystem()
	if not ConfigState.lagSystemLoaded then
		return
	end
	ConfigState.lagSystemLoaded = false
	ConfigState.isLagActive = false
end
function checkLagState()
	local shouldLoad = ConfigState.lagSwitchEnabled
	if shouldLoad and not ConfigState.lagSystemLoaded then
		loadLagSystem()
	elseif not shouldLoad and ConfigState.lagSystemLoaded then
		unloadLagSystem()
	end
end
