local PlayerStatConnection = {
	["Original Stats"] = nil,
	["Original Instance Changed"] = nil
}
local StatScreenUI = nil
function PlayerStatsStart()
	StatScreenUI = Instance.new("ScreenGui")
	StatScreenUI.Name = "Player Stat Gui"
	StatScreenUI.ResetOnSpawn = false
	StatScreenUI.IgnoreGuiInset = false
	StatScreenUI.DisplayOrder = 2147

	local player_stat_frame = Instance.new("Frame")
	player_stat_frame.Name = "Player Stat Frame"
	player_stat_frame.Size = UDim2.fromScale(1, 1)
	player_stat_frame.Position = UDim2.fromScale(0, 0)
	player_stat_frame.BackgroundTransparency = 1
	player_stat_frame.Parent = StatScreenUI

	local HomePage = PlayerGui:WaitForChild("HomePage")
	local OG_PlayerStats = HomePage:WaitForChild("Root"):WaitForChild("Bottom")

	OG_PlayerStats.Archivable = true
	local cloned_playerStats = OG_PlayerStats:Clone()
	cloned_playerStats.Parent = player_stat_frame

	StatScreenUI.Parent = PlayerGui

	for _, descendant in ipairs(cloned_playerStats:GetDescendants()) do
		if descendant:IsA("GuiObject") then
			if descendant.Visible == false then
				descendant.Visible = true
			end
			if descendant.Active == true then
				descendant.Active = false
			end
			if descendant.Name == "Plus" then
				descendant:Destroy()
			end
		end
	end

	local function FindClonedStat(originalDescendant)
		local relativePath = {}
		local current = originalDescendant

		for _ = 1, 100 do
			if not current or current == OG_PlayerStats then
				break
			end
			table.insert(relativePath, 1, current.Name)
			current = current.Parent
		end
		local targetClone = cloned_playerStats
		for _, name in ipairs(relativePath) do
			targetClone = targetClone:FindFirstChild(name)
			if not targetClone then break end
		end

		return targetClone
	end

	local function StatBindSync(originalInstance)
		local connection = originalInstance.Changed:Connect(function(property)
			if property == "Parent" then return end

			local matchingClone = FindClonedStat(originalInstance)
			if matchingClone then
				pcall(function()
					matchingClone[property] = originalInstance[property]
					if matchingClone:IsA("GuiObject") and property == "Visible" then
						matchingClone.Visible = true
					end
				end)
			end
		end)
		table.insert(PlayerStatConnection, connection)
	end

	for _, descendant in ipairs(OG_PlayerStats:GetDescendants()) do
		StatBindSync(descendant)
	end

	local descendantAddedConnection = OG_PlayerStats.DescendantAdded:Connect(function(descendant)
		StatBindSync(descendant)
		task.defer(function()
			local parentClone = FindClonedStat(descendant.Parent)
			if parentClone and not parentClone:FindFirstChild(descendant.Name) and not (descendant.Name == "Plus") then
				local newClone = descendant:Clone()
				if newClone:IsA("GuiObject") then
					newClone.Visible = true
				end
				newClone.Parent = parentClone
			end
		end)
	end)
	table.insert(PlayerStatConnection, descendantAddedConnection)
end

function PlayerStatsStop()
	for key, connection in pairs(PlayerStatConnection) do
		if typeof(connection) == "RBXScriptConnection" then
			if connection.Connected then
				connection:Disconnect()
			end
		end
		PlayerStatConnection[key] = nil
	end

	if StatScreenUI then
		StatScreenUI:Destroy()
		StatScreenUI = nil
	end
end

