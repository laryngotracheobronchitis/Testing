		return
	end
	ConfigState.CheckingGameTimer = true
	local last = 0
	ConfigState._gameTimerConnection = RunService.Heartbeat:Connect(function()
		local now = os.clock()
		if now - last < 0.1 then
			return
		end
		last = now
		CheckGameTimerVisibility()
	end)
end
function StopGameTimerCheck()
	ConfigState.CheckingGameTimer = false
	if ConfigState._gameTimerConnection then
		ConfigState._gameTimerConnection:Disconnect()
		ConfigState._gameTimerConnection = nil
