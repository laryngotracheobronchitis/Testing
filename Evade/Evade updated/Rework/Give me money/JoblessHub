}
function AutoExchangePrettyNumber(n)
	if n ~= math.floor(n) then
		return tostring(n)
	end
	local formatted = tostring(math.floor(n)):reverse():gsub("(%d%d%d)", "%1,"):reverse()
	return (formatted:gsub("^,", ""))
end
function AutoExchangeCurrencyLabel(to)
	return currencyLabels[to] or tostring(to)
end
function AutoExchangeBuildOptions()
	exchangeOptions = {}
	exchangeLabels = {}
	local top = math.max(PlayerData.Tickets(), 100)
	for _, entry in ipairs(PlayerData.EventExchanges()) do
		if type(entry) ~= "table" or entry.To == nil or type(entry.Rate) ~= "number" then
			continue
		end
		local name = AutoExchangeCurrencyLabel(entry.To)
		for power = 0, math.floor(math.log10(top)) do
			local amount = 10 ^ power
			local label = string.format("%s %s [%s Ticket%s]", AutoExchangePrettyNumber(entry.Rate * amount), name, AutoExchangePrettyNumber(amount), amount == 1 and "" or "s")
			exchangeOptions[label] = {
				to = entry.To,
				amount = amount
			}
			table.insert(exchangeLabels, label)
		end
		local allLabel = string.format("%s %s per Ticket [All Tickets]", AutoExchangePrettyNumber(entry.Rate), name)
		exchangeOptions[allLabel] = {
			to = entry.To,
			all = true
		}
		table.insert(exchangeLabels, allLabel)
	end
	if # exchangeLabels == 0 then
		exchangeLabels = {"No exchange available"}
	end
	if not exchangeOptions[selectedExchange] then
		selectedExchange = exchangeLabels[1]
	end
end
function AutoExchangeRefreshDropdown()
	AutoExchangeBuildOptions()
	if exchangeDropdown then
		exchangeDropdown:Refresh(exchangeLabels, selectedExchange)
	end
end
function AutoExchangeNotify(content)
	WindUI:Notify({
		Title = "Auto Exchange",
		Content = content,
		Duration = 5
	})
end
function AutoExchangeRunOnce()
	if ConfigState.exchangePending then
		return
	end
	local choice = exchangeOptions[selectedExchange]
	if not choice then
		return
	end
	local tickets = PlayerData.Tickets()
	local amount = choice.all and tickets or choice.amount
	if tickets <= 0 or tickets < amount then
		return
	end
	ConfigState.exchangePending = true
	PlayerData.Exchange(choice.to, amount)
	task.delay(1.5, function()
		ConfigState.exchangePending = false
		if PlayerData.Tickets() >= tickets then
			ConfigState.exchangeFailures = ConfigState.exchangeFailures + 1
			if ConfigState.exchangeFailures >= 3 and autoExchangeToggle then
				ConfigState.exchangeFailures = 0
				autoExchangeToggle:Set(false)
				AutoExchangeNotify("The server did not take the exchange (event phase: " .. tostring(PlayerData.EventPhase()) .. "). Stopped.")
			end
		else
			ConfigState.exchangeFailures = 0
		end
	end)
end
function StopAutoExchange()
	if exchangeConn then
		exchangeConn:Disconnect()
		exchangeConn = nil
	end
	ConfigState.exchangePending = false
	ConfigState.exchangeFailures = 0
end
function StartAutoExchange()
	StopAutoExchange()
	AutoExchangeRefreshDropdown()
	exchangeConn = HeartbeatLoop(ConfigState.exchangeDelay, AutoExchangeRunOnce)
end
