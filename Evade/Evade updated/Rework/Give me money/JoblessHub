								Owned = item.Owned,
								State = tier.State
							}
							add(key)
						end
					end
				end
				return keys
			end
			local function buildOptions(keys, liveSet)
				if # keys == 0 then
					return {
						{
							Title = "No items available",
							Desc = "Check back later or refresh",
							Value = "none"
						}
					}
				end
				local options = {}
