function StartRampBooster()
	StopRampBooster()
		local armed = true
		ConfigState.rampBoostConnection = RunService.Heartbeat:Connect(function(dt)
			local character = LocalPlayer.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			local root = humanoid and (humanoid.RootPart or character.PrimaryPart)
			if not root then
				return
			end
			local velocity = root.AssemblyLinearVelocity
			local vy = velocity.Y
			local gravity = workspace.Gravity
			local jumpSpeed = humanoid.UseJumpPower and humanoid.JumpPower or math.sqrt(2 * gravity * humanoid.JumpHeight)
			local limit = jumpSpeed + gravity * dt
			if not armed and vy <= 0 then
				armed = true
			end
			if armed and vy > limit then
				armed = false
				root.AssemblyLinearVelocity = Vector3.new(velocity.X, vy * ConfigState.rampBoostMultiplier, velocity.Z)
			end
		end)
	end
	RampBoosterToggle = Tabs.Player:Toggle({
