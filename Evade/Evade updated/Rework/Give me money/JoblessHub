-- =====================================================================
-- JoblessHub: Floating Button Size Adjustment (global)
-- Built on top of the ORIGINAL ButtonLib element system: the floating
-- buttons, their drag system, positions, callbacks and interactions are
-- untouched - only frame.Size is scaled while the setting is enabled.
-- X = width, Y = height. Roblox 2D UI has no Z size dimension (ZIndex
-- only controls render order, not size), so no fake Z control is made.
-- =====================================================================
ConfigState.FloatingButtonSize = {
	Enabled = false,
	XScale = 1,
	YScale = 1
}
local FloatingButtonBaseSizes = setmetatable({}, { __mode = "k" })
local function CaptureFloatingButtonBaseSize(frame)
	local base = FloatingButtonBaseSizes[frame]
	if base then
		return base
	end
	base = {
		XScale = frame.Size.X.Scale,
		XOffset = frame.Size.X.Offset,
		YScale = frame.Size.Y.Scale,
		YOffset = frame.Size.Y.Offset
	}
	FloatingButtonBaseSizes[frame] = base
	return base
end
function GetFloatingButtonFrames()
	local frames = {}
	local elements = ButtonLib and ButtonLib._elements
	if elements then
		for _, list in pairs(elements) do
			for _, elementData in ipairs(list) do
				if elementData and elementData.instance and elementData.instance.Parent then
					table.insert(frames, elementData.instance)
				end
			end
		end
	end
	return frames
end
function ApplyFloatingButtonSize()
	local enabled = ConfigState.FloatingButtonSize.Enabled
	local xScale = enabled and (tonumber(ConfigState.FloatingButtonSize.XScale) or 1) or 1
	local yScale = enabled and (tonumber(ConfigState.FloatingButtonSize.YScale) or 1) or 1
	for _, frame in ipairs(GetFloatingButtonFrames()) do
		pcall(function()
			local base = CaptureFloatingButtonBaseSize(frame)
			frame.Size = UDim2.new(base.XScale, base.XOffset * xScale, base.YScale, base.YOffset * yScale)
		end)
	end
end
local function HookFloatingButtonCreation()
	if not (ButtonLib and ButtonLib.Create) then
		return
	end
	if ButtonLib.Create.JoblessSizeHooked then
		return
	end
	local createTable = ButtonLib.Create
	local originalButton = createTable.Button
	local originalToggle = createTable.Toggle
	createTable.Button = function(self, config)
		local api = originalButton(self, config)
		task.defer(ApplyFloatingButtonSize)
		return api
	end
	createTable.Toggle = function(self, config)
		local api = originalToggle(self, config)
		task.defer(ApplyFloatingButtonSize)
		return api
	end
	createTable.JoblessSizeHooked = true
end
HookFloatingButtonCreation()
