function HeartbeatLoop(interval, fn)
	local last = 0
	local busy = false
	return RunService.Heartbeat:Connect(function()
		if busy then
			return
		end
		local now = os.clock()
		if now - last < interval then
			return
		end
		last = now
		busy = true
		local ok, err = pcall(fn)
		busy = false
		if not ok then
			warn("[HeartbeatLoop] " .. tostring(err))
		end
	end)
end
