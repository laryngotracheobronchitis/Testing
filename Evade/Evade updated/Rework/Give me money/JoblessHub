			end)
			task.wait()
			local function notify(title, content)
				pcall(function()
					WindUI:Notify({
						Title = title,
						Content = content,
						Duration = 3
					})
				end)
			end
			local function makeMultiShop(parent)
				local MIN_AMOUNT, MAX_AMOUNT, MAX_QUEUE, QUEUE_DELAY = 1, 100, 20, 0.5
				local amount = MIN_AMOUNT
				local queueEnabled = true
				local queue, pending, queueConn = {}, {}, nil
				local function multiKeys()
					local keys = {}
					for _, key in ipairs(tokenItemKeys()) do
						if isMultiple(key) then
							table.insert(keys, key)
						end
					end
					return keys
				end
				local function clampAmount(value)
					local n = tonumber(value)
					if not n or n ~= n then
						return nil
					end
					return math.clamp(math.floor(n), MIN_AMOUNT, MAX_AMOUNT)
				end
				local function multiOptions(keys)
					if # keys == 0 then
						return {
							{
								Title = "No items available",
								Desc = "Check back later or refresh",
								Value = "none"
							}
						}
					end
					local options = {}
					for _, key in ipairs(keys) do
						local record = PlayerData.StockRecord(key) or {}
						local purchase = (configOf(key) or {}).PurchaseInfo or {}
						local unit = PlayerData.PriceOf(key) or purchase.Price
						local currency = record.Currency or purchase.Currency or ""
						local parts = {}
						if unit then
							table.insert(parts, string.format("Price: %s x %d = %s %s", tostring(unit), amount, tostring(unit * amount), currency))
						else
							table.insert(parts, "Not on sale right now")
						end
						table.insert(parts, "Owned: " .. tostring(ownedCountOf(key)))
						local requirement = levelRequirementOf(key)
						if requirement > 0 then
							table.insert(parts, meetsLevel(key) and ("Lv " .. requirement .. " OK") or ("LOCKED: needs Lv " .. requirement))
						end
						table.insert(options, {
							Title = nameOf(key),
							Desc = table.concat(parts, " | "),
							Value = key
						})
					end
					return options
				end
				local sectionApi
				local function stopQueue()
					if queueConn then
						queueConn:Disconnect()
						queueConn = nil
					end
				end
				local function clearAutoJobs()
					for index = # queue, 1, - 1 do
						local job = queue[index]
						if not job.manual then
							pending[job.key] = nil
							table.remove(queue, index)
						end
					end
					if # queue == 0 then
						stopQueue()
					end
				end
				local function processQueue()
					if queueConn then
						return
					end
					queueConn = HeartbeatLoop(QUEUE_DELAY, function()
						local job = table.remove(queue, 1)
						if not job then
							stopQueue()
							return
						end
						pcall(buyUnit, job.key, job.amount)
						pending[job.key] = nil
						if sectionApi then
							sectionApi.refresh()
						end
						if # queue == 0 then
							stopQueue()
						end
					end)
				end
				local function multiBuy(key, manual)
					if not meetsLevel(key) then
						return false
					end
					if not queueEnabled then
						return buyUnit(key, amount)
					end
					if pending[key] or # queue >= MAX_QUEUE then
						return false
					end
					pending[key] = true
					table.insert(queue, {
						key = key,
						amount = amount,
						manual = manual
					})
					processQueue()
					return true
				end
				sectionApi = makeShopSection("Multiple Item Shop", "Right", multiKeys, nil, parent, {
					options = function(keys)
						return multiOptions(keys)
					end,
					buy = multiBuy,
					onAutoStop = clearAutoJobs,
					setup = function(section, api)
						local amountInput = section:Input({
							Title = "Buy Amount (" .. MIN_AMOUNT .. "-" .. MAX_AMOUNT .. ")",
							Desc = "Invalid values are reset automatically",
							Flag = "MultiShopAmount",
							Placeholder = tostring(MIN_AMOUNT),
							Value = tostring(MIN_AMOUNT),
							NumbersOnly = true,
						})
						amountInput.Callback = function(value)
							local n = clampAmount(value)
							if not n then
								n = amount
							end
							amount = n
							if tostring(value) ~= tostring(n) then
								pcall(function()
									amountInput:Set(tostring(n))
								end)
							end
							api.refresh()
						end
						local queueCheckbox = section:Toggle({
							Title = "Buy Queue",
							Desc = "Purchases run one at a time to prevent spam",
							Flag = "MultiShopQueue",
							Type = "Checkbox",
							Value = true,
						})
						queueCheckbox.Callback = function(state)
							queueEnabled = state
						end
						section:Button({
							Title = "Buy Selected Amount",
							Callback = function()
								local chosen = api.getSelected()
								if # chosen == 0 then
									notify("No item", "Select a Multiple item first")
									return
								end
								for _, key in ipairs(chosen) do
									if not meetsLevel(key) then
										notify("Locked", nameOf(key) .. " requires level " .. levelRequirementOf(key))
									elseif not multiBuy(key, true) then
										notify("Not bought", nameOf(key) .. " is already queued, or balance is too low")
									end
								end
								api.refresh()
							end
						})
					end
				})
				return sectionApi
			end
			local tokenParent = Tabs.Shop:Section({
				Title = "Token Shop",
				Side = "Right"
			})
			local multiShop = makeMultiShop(tokenParent)
			local tokenSections = {}
			local function ensureTokenOverviewSections()
				for _, key in ipairs(tokenItemKeys()) do
					local overview = overviewOf(key)
					if not tokenSections[overview] then
						tokenSections[overview] = makeShopSection("Token " .. overview, "Right", function()
							local keys = {}
							for _, k in ipairs(tokenItemKeys()) do
								if overviewOf(k) == overview then
									table.insert(keys, k)
								end
							end
							return keys
						end, nil, tokenParent)
					end
				end
			end
			ensureTokenOverviewSections()
			local tokens = {
				refresh = function()
					ensureTokenOverviewSections()
					for _, sectionApi in pairs(tokenSections) do
						sectionApi.refresh()
					end
					multiShop.refresh()
				end
			}
			task.wait()
			local event = nil
			local function ensureEventSection()
				if event ~= nil then
					return true
				end
				if not PlayerData.EventActive() then
					return false
				end
				event = makeShopSection("Event Shop", "Left", eventItemKeys, function()
					return slotItemKeys("Event")
				end)
				return true
			end
			ensureEventSection()
			task.wait()
			refreshAll = function()
				daily.refresh();
				tokens.refresh()
				if ensureEventSection() then
					event.refresh()
				end
			end
		end)
	end
})

