		makefolder("JoblessHub/AutoLoad")
		makefolder("JoblessHub/AutoLoad/Game")
		makefolder("JoblessHub/AutoLoad/Game/Evade")
	end
	local data = {
		enabled = ConfigState.AutoLoadEnabled,
		configName = ConfigState.AutoLoadConfig
	}
	local json = HttpService:JSONEncode(data)
	WriteFile(autoLoadFile, json)
end
