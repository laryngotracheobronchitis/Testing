			local function makeShopSection(title, side, getKeys, getLiveKeys, parent, opts)
				local section
				if parent then
					section = makeSubSection(parent, title)
				else
					section = Tabs.Shop:Section({
						Title = title,
						Side = side
					})
				end
				local selected = {}
				local dropdown
				local lastSignature = nil
				local optionsFn = opts and opts.options or buildOptions
				local buyFn = opts and opts.buy or buyUnit
				local function liveSetOf()
					if not getLiveKeys then
						return nil
					end
					local set = {}
					for _, key in ipairs(getLiveKeys()) do
						set[key] = true
					end
					return set
				end
				local function signatureOf(options)
					local parts = {}
					for _, option in ipairs(options) do
						table.insert(parts, option.Value .. "|" .. option.Desc)
					end
					return table.concat(parts, "\n")
				end
				local function refreshShopDropdownOptions()
					local options = optionsFn(getKeys(), liveSetOf())
					local signature = signatureOf(options)
					if signature == lastSignature then
						return
					end
					lastSignature = signature
					local valueSet = {}
					for _, option in ipairs(options) do
						valueSet[option.Value] = true
					end
					local valid = {}
					for _, value in ipairs(selected) do
						if valueSet[value] then
							table.insert(valid, value)
						end
					end
					selected = valid
					if dropdown then
						dropdown.Refresh(dropdown, options, valid)
					end
				end
				local api = {
					refresh = function()
						refreshShopDropdownOptions()
					end,
					getSelected = function()
						return selected
					end
				}
				if opts and opts.setup then
					opts.setup(section, api)
				end
				local initialOptions = optionsFn(getKeys(), liveSetOf())
				lastSignature = signatureOf(initialOptions)
				dropdown = section:Dropdown({
					Title = "Select " .. title .. " Items",
					SearchBarEnabled = true,
					Values = initialOptions,
					Multi = true,
					AllowNone = true,
					Callback = function(choices)
						selected = {}
						for _, choice in ipairs(choices or {}) do
							if choice.Value and choice.Value ~= "none" then
								table.insert(selected, choice.Value)
							end
						end
					end
				})
				section:Button({
					Title = "Refresh " .. title,
					Callback = function()
						if refreshAll then
							refreshAll()
						else
							refreshShopDropdownOptions()
						end
					end
				})
