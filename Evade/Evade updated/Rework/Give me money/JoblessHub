							end
						end)
					else
						stopLoop(title .. "_all")
						if opts and opts.onAutoStop then
							opts.onAutoStop()
						end
					end
				end
				local AutoBuySelectedItems = section:Toggle({
					Title = "Auto Buy Selected " .. title .. " Items",
					Value = false,
				})
				AutoBuySelectedItems.Callback = function(state)
					if state then
						startLoop(title .. "_selected", function()
							getKeys()
							for _, key in ipairs(selected) do
								buyFn(key)
							end
						end)
					else
						stopLoop(title .. "_selected")
						if opts and opts.onAutoStop then
