	end)
	if not okInfo or type(info) ~= "table" then
		info = {}
	end
	local ColaCheat = {
		["Visual Infinite"] = false,
		["Cola Modifier"] = false,
		["Loaded"] = false,
		["Custom Duration"] = tonumber(info.Duration),
		["Custom Speed"] = tonumber(info.SpeedBoost),
		["Original Activate"] = nil,
		["Patched"] = nil,
		["Watcher"] = nil,
		["Pending Drink"] = nil,
		["Reassert Thread"] = nil,
		["Drink Tools"] = setmetatable({}, { __mode = "k" }),
	}

	function ColaCheatFindColor3InTable(value, seen)
		if typeof(value) == "Color3" then
			return value
		end
		if type(value) ~= "table" or seen[value] then
			return nil
		end
		seen[value] = true
		for _, child in pairs(value) do
			local found = ColaCheatFindColor3InTable(child, seen)
			if found then
				return found
			end
		end
		return nil
	end

	function ColaCheatCollectToolActivationMethods(toolInfo)
		local list = {}
		for _, taskInfo in pairs(toolInfo.Tasks or {}) do
			for _, functionInfo in pairs(taskInfo.Functions or {}) do
				for _, activation in pairs(functionInfo.Activations or {}) do
					for _, method in pairs(activation.Methods or {}) do
						list[#list + 1] = method
					end
				end
			end
			for _, functionInfo in pairs(taskInfo.AutomaticFunctions or {}) do
				for _, method in pairs(functionInfo.Methods or {}) do
					list[#list + 1] = method
				end
			end
		end
		return list
	end

	function ColaCheatIsSpeedBoostMethod(method)
		return type(method) == "table" and type(method.Info) == "table" and method.Info.SpeedBoost ~= nil
	end

	function ColaCheatIsDrinkBoostTool(tasks)
		local cached = ColaCheat["Drink Tools"][tasks]
		if cached == nil then
			cached = false
			if type(tasks.Info) == "table" then
				for _, method in ipairs(ColaCheatCollectToolActivationMethods(tasks.Info)) do
					if ColaCheatIsSpeedBoostMethod(method) then
						cached = true
						break
					end
				end
			end
			ColaCheat["Drink Tools"][tasks] = cached
		end
		return cached
	end

	function ColaCheatIsLocalPlayerToolOwner(tasks)
		local owner = tasks.Parent and tasks.Parent.Parent and tasks.Parent.Parent.Parent
		return owner ~= nil and owner.Local == true
	end


	function ColaCheatIsDrinkMethod(tasks, method)
		local okRef, reference = pcall(function()
			return tasks:GetMethodReferenceFromMethodTable(method)
		end)
		if okRef and reference and DrinkTaskType and getmetatable(reference) == DrinkTaskType then
			return true
		end
		return method.MethodReferencing == "Drink" and (method.ActivationType == "Start" or method.ActivationType == "End")
	end
	function ColaCheatShouldInterceptActivate(tasks, method)
		if not ColaCheat["Visual Infinite"] or type(method) ~= "table" or not ColaCheatIsDrinkBoostTool(tasks) then
			return false
		end
		if not (ColaCheatIsDrinkMethod(tasks, method) or ColaCheatIsSpeedBoostMethod(method) or method.ItemUseIncrement ~= nil) then
			return false
		end
		return ColaCheatIsLocalPlayerToolOwner(tasks)
	end

	function ColaCheatFireSpeedChange(character, tasks, value, length)
		FireClient(colaCharacterTask, character:GetAttribute("Tag"), "Movement", {
			SpeedChange = {
				Value = value,
				Type = tasks.Module.Name,
				Length = length,
			},
		})
	end

	function ColaCheatApplyBoostEffects(tasks, method, withVignette)
		local character = LocalPlayer.Character
		local boostInfo = method.Info
		local defaultLength = boostInfo.Duration or boostInfo.Length
		local value = boostInfo.SpeedBoost
		local length = defaultLength
		local vignetteLength = boostInfo.SuccessImmortalLength or defaultLength
		if ColaCheat["Cola Modifier"] then
			value = ColaCheat["Custom Speed"] or value
			length = ColaCheat["Custom Duration"] or length
			if ColaCheat["Custom Duration"] then
				vignetteLength = ColaCheat["Custom Duration"]
			end
		end
		if withVignette then
			local color = ColaCheatFindColor3InTable(boostInfo, {}) or ColaCheatFindColor3InTable(tasks.Info, {})
			if color then
				FireClient(colaSharedUI, "Vignette", color, vignetteLength, true)
			end
		end
		ColaCheatFireSpeedChange(character, tasks, value, length)
		return value, length, defaultLength
	end

	function ColaCheatReassertBoostAfterServer(tasks, value, length, defaultLength, character)
		if type(defaultLength) ~= "number" or type(length) ~= "number" or length <= defaultLength then
			return
		end
		if ColaCheat["Reassert Thread"] then
			pcall(task.cancel, ColaCheat["Reassert Thread"])
		end
		ColaCheat["Reassert Thread"] = task.delay(defaultLength, function()
			ColaCheat["Reassert Thread"] = nil
			if ColaCheat["Loaded"] then
				ColaCheatFireSpeedChange(character, tasks, value, length - defaultLength)
			end
		end)
	end

	function ColaCheatActivateMethodLocally(tasks, method)
		local reference = tasks:GetMethodReferenceFromMethodTable(method)
		local resource = tasks:GetResourceFromMethodTable(method)
		if reference then
			reference.LastActivated = tick()
		end
		if method.ResourceIncrement and resource then
			resource:Increment(method.ResourceIncrement)
		end
		local activationType, requirement = tasks:ActivationTypeFromMethodTable(method)
		local cooldown
		if requirement ~= "Update" then
			local cooldownInfo = tasks:GetCooldownInfoFromMethod(method)
			tasks.Parent:AddCooldown(cooldownInfo)
			cooldown = cooldownInfo.Cooldown
		end
		local viewmodelData
		local characterData
		if reference then
			local _, viewmodel, characterVisual = reference:ActivateClient(activationType, method)
			viewmodelData = viewmodel
			characterData = characterVisual
		end
		if method.VisualName then
			tasks.Parent.Parent.ViewmodelVisuals:Task(method.VisualName, viewmodelData)
			tasks.Parent.Parent.CharacterVisuals:Task(method.VisualName, characterData)
		end
		return cooldown
	end

	function ColaCheatOnServerSpeedBoost(tag, kind, data)
		local pending = ColaCheat["Pending Drink"]
		if not pending or kind ~= "Movement" or type(data) ~= "table" or data.SpeedChange == nil then
			return
		end
		if pending.character:GetAttribute("Tag") ~= tag then
			return
		end
		ColaCheat["Pending Drink"] = nil
		if os.clock() > pending.expires then
			return
		end
		task.defer(function()
			if not ColaCheat["Loaded"] then
				return
			end
			local value, length, defaultLength = ColaCheatApplyBoostEffects(pending.tasks, pending.method, false)
			if value then
				ColaCheatReassertBoostAfterServer(pending.tasks, value, length, defaultLength, pending.character)
			end
		end)
	end

	ColaCheat["Patched"] = function(self, method, data)
		if not ColaCheat["Loaded"] then
			return ColaCheat["Original Activate"](self, method, data)
		end
		if ColaCheatShouldInterceptActivate(self, method) then
			local cooldown = ColaCheatActivateMethodLocally(self, method)
			if ColaCheatIsSpeedBoostMethod(method) then
				ColaCheatApplyBoostEffects(self, method, true)
			end
			return cooldown
		end
		local result = ColaCheat["Original Activate"](self, method, data)
		if ColaCheat["Cola Modifier"] and ColaCheatIsSpeedBoostMethod(method) and ColaCheatIsDrinkBoostTool(self) and ColaCheatIsLocalPlayerToolOwner(self) and LocalPlayer.Character then
			local cooldown = result
			if type(cooldown) ~= "number" then
				local cooldownInfo = self:GetCooldownInfoFromMethod(method)
				cooldown = cooldownInfo and cooldownInfo.Cooldown
			end
			ColaCheat["Pending Drink"] = {
				tasks = self,
				method = method,
				character = LocalPlayer.Character,
				expires = os.clock() + (cooldown or method.Info.Duration or method.Info.Length or 0),
			}
		end
		return result
	end

	function ColaCheatLoadHooks()
		if ColaCheat["Loaded"] then
			return
		end
		ColaCheat["Loaded"] = true
		if not ColaCheat["Original Activate"] then
			ColaCheat["Original Activate"] = ToolTasks.Activate
		end
		if ToolTasks.Activate == ColaCheat["Original Activate"] then
			ToolTasks.Activate = ColaCheat["Patched"]
		end
		ColaCheat["Watcher"] = colaCharacterTask.OnClientEvent:Connect(ColaCheatOnServerSpeedBoost)
	end

	function ColaCheatUnloadHooks()
		if not ColaCheat["Loaded"] then
			return
		end
		ColaCheat["Loaded"] = false
		if ToolTasks.Activate == ColaCheat["Patched"] then
			ToolTasks.Activate = ColaCheat["Original Activate"]
		end
		if ColaCheat["Watcher"] then
			ColaCheat["Watcher"]:Disconnect()
			ColaCheat["Watcher"] = nil
		end
		if ColaCheat["Reassert Thread"] then
			pcall(task.cancel, ColaCheat["Reassert Thread"])
			ColaCheat["Reassert Thread"] = nil
		end
		ColaCheat["Pending Drink"] = nil
	end

	function ColaCheatRefreshHooks()
		if ColaCheat["Visual Infinite"] or ColaCheat["Cola Modifier"] then
			ColaCheatLoadHooks()
		else
			ColaCheatUnloadHooks()
