Tabs.Teleport:Button({
	Title = "Teleport NOW!!! >:(",
	Icon = "target",
	Callback = function()
		local function parseCoordinate(token, current)
			if not token or token == "" then
				return nil
			end
			token = token:gsub("%s+", "")
			local num = tonumber(token)
			if num then
				return num
			end
			if token:sub(1, 1) == "~" then
				local rest = token:sub(2)
				if rest == "" then
					return current
				end
				local op = rest:sub(1, 1)
				local valuePart = rest:sub(2)
				if op == "+" or op == "-" or op == "*" then
					local val = tonumber(valuePart)
					if val then
						if op == "+" then
							return current + val
						elseif op == "-" then
							return current - val
						elseif op == "*" then
							return current * val
						end
					end
				else
					local val = tonumber(rest)
					if val then
						return current + val
					end
				end
			end
			return nil
		end
		local tokens = {}
		for token in string.gmatch(ConfigState.teleInputValue, "%S+") do
			table.insert(tokens, token)
		end
		if # tokens < 3 then
			WindUI:Notify({
				Title = "Invalid Input",
				Content = "Please enter three values for X, Y, Z separated by spaces",
				Duration = 3
			})
			return
		end
		local character = LocalPlayer.Character
		if not character then
			WindUI:Notify({
				Title = "Error",
				Content = "Character not found",
				Duration = 3
			})
			return
		end
		local root = character:FindFirstChild("HumanoidRootPart")
		if not root then
			WindUI:Notify({
				Title = "Error",
				Content = "HumanoidRootPart not found",
				Duration = 3
			})
			return
		end
		local currentPos = root.Position
		local x = parseCoordinate(tokens[1], currentPos.X)
		local y = parseCoordinate(tokens[2], currentPos.Y)
		local z = parseCoordinate(tokens[3], currentPos.Z)
		if x == nil or y == nil or z == nil then
			WindUI:Notify({
				Title = "Invalid Expression",
				Content = "One or more coordinates could not be parsed",
				Duration = 3
			})
			return
		end
		root.CFrame = CFrame.new(x, y, z)
	end
})
