local function requireUserDataService(name)
	local client = ReplicatedStorage:FindFirstChild("Client")
	local services = client and client:FindFirstChild("Services")
	local userData = services and services:FindFirstChild("UserData")
	local module = userData and userData:FindFirstChild(name)
	if not module then
		return nil
	end
	return require(module)
end
local function getCachedUserDataService(name)
	local service = ConfigState.userDataServices[name]
	if service == nil then
		service = requireUserDataService(name)
		ConfigState.userDataServices[name] = service
	end
	return service
end
local function callUserDataService(serviceName, method, ...)
	local service = ConfigState.userDataServices[serviceName]
	if service == nil then
		service = requireUserDataService(serviceName)
		ConfigState.userDataServices[serviceName] = service
	end
	return (service[method])(...)
end
