popupservice_rewards_speed_toggle = Tabs.Visuals:Toggle({
    Title = "Speedup Popup Rewards",
    Flag = "popupservice_rewards_speed_toggle",
    Value = false,
    Callback = function(s)
        if s then
            if not PopupService_Rewards or type(PopupService_Rewards.ShowAnimation) ~= "function" then
                warn("[JoblessHub] Rewards popup module not loaded, speed patch skipped")
                return
            end
            if not (getfenv and setfenv) then
                warn("[JoblessHub] This executor has no getfenv/setfenv, speed patch unavailable")
                return
            end
            if PopupService_Rewards._speedPatched then
                return
            end

            local original = PopupService_Rewards.ShowAnimation
            local baseEnv = getfenv(original)
            local baseTween = baseEnv.tween

            PopupService_Rewards._originalEnv = baseEnv
            PopupService_Rewards._speedPatched = true

            local proxyTask = setmetatable({}, { __index = task })
            proxyTask.wait = function(t)
                local mult = tonumber(ConfigState.popupservice_rewards_speed) or 1
                if type(t) == "number" and t > 0 then
                    return task.wait(t / mult)
                end
                return task.wait(t)
            end

            local proxyTween = function(inst, goal, time, style, dir, rev)
                local mult = tonumber(ConfigState.popupservice_rewards_speed) or 1
                return baseTween(inst, goal, time / mult, style, dir, rev)
            end

            setfenv(original, setmetatable({
                task = proxyTask,
                tween = proxyTween,
            }, { __index = baseEnv }))
        else
            if PopupService_Rewards and PopupService_Rewards._originalEnv then
                setfenv(PopupService_Rewards.ShowAnimation, PopupService_Rewards._originalEnv)
            end
            PopupService_Rewards._originalEnv = nil
            PopupService_Rewards._speedPatched = nil
        end
    end
})

