function FileExists(path)
	if isfile then
		return isfile(path)
	end
	return false
end
function WriteFile(path, content)
	if writefile then
		writefile(path, content)
		return true
	end
	return false
end
function ReadFile(path)
	if readfile then
		return readfile(path)
	end
	return ""
end
function loadAutoLoadSettings()
	local autoLoadFile = "JoblessHub/AutoLoad/Game/Evade/AutoLoad.json"
	if FileExists(autoLoadFile) then
		local content = ReadFile(autoLoadFile)
		if content ~= "" then
			local data = HttpService:JSONDecode(content)
			if data then
				ConfigState.AutoLoadConfig = data.configName or "default"
				ConfigState.AutoLoadEnabled = data.enabled or false
				return true
			end
		end
	end
	ConfigState.AutoLoadConfig = "default"
	ConfigState.AutoLoadEnabled = false
	return false
end
function saveAutoLoadSettings()
	local autoLoadFile = "JoblessHub/AutoLoad/Game/Evade/AutoLoad.json"
