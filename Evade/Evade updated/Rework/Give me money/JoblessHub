if shopPanel and type(shopPanel._startHold) == "function" then
	if setreadonly then
		setreadonly(shopPanel, false)
	end
	local originalStartHold = shopPanel._startHold
	shopPanel._startHold = function(self)
		if ConfigState.purchaseHoldDelay == ConfigState.defaultHoldDelay then
			return originalStartHold(self)
		end
		if self._holdTween ~= nil or self._isBusy or not self._holdsToBuy then
			return
		end
		if ConfigState.purchaseHoldDelay <= 0 then
			self._holdInput = nil
			self:_purchase()
			return
		end
		local hold = self.Frame.Buy.Hold
		hold.Size = UDim2.fromScale(0, 1)
		hold.Visible = true
		local tween = TweenService:Create(hold, TweenInfo.new(ConfigState.purchaseHoldDelay, Enum.EasingStyle.Linear), {
			Size = UDim2.fromScale(1, 1)
		})
		self._holdTween = tween
		tween.Completed:Once(function(state)
			if self._holdTween == tween and state == Enum.PlaybackState.Completed then
				self._holdTween = nil
				self._holdInput = nil
				self:_purchase()
				hold.Visible = false
			end
		end)
		tween:Play()
	end
end
