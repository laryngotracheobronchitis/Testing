ConfigState.originalRegistry = Movement.RegistryTermUpdated
Movement.RegistryTermUpdated = function(self, term)
	if term == "Emote" then
		ConfigState.activeMovement = self
		local id = self.DataRegistry:Get("Emote")
		if id and id ~= 0 then
			local item = ClientItemService:GetItemFromID(id)
			local mult = item and (require(item).EmoteInfo or {}).SpeedMult or 1
			if ConfigState.emoteSpeedEnabled and ConfigState.emoteSpeedType == "Blatant" then
				if ConfigState.applyUnwalkableEmoteSpeed and mult <= 0 then
					mult = 1
				end
				self.MoveStats:SpeedChange("Emote", mult * (ConfigState.emoteSpeedValue / 1000))
			else
				self.MoveStats:SpeedChange("Emote", mult)
			end
		else
			self.MoveStats:SpeedChange("Emote", nil)
		end
		return
	end
	ConfigState.originalRegistry(self, term)
end
ConfigState.originalMovementUpdate = Movement.Update
ConfigState.lastFriction = nil
Movement.Update = function(self, ...)
	ConfigState.originalMovementUpdate(self, ...)
	local humanoid = self.Character and self.Character:FindFirstChild("Humanoid")
	if not humanoid then
		return
	end
	if self.Character == Players.LocalPlayer.Character then
		ConfigState.activeMovement = self
	end
	local LocalPlayerData = CharacterService:GetCharacterFromPlayer(LocalPlayer)
	local movementData = LocalPlayerData and LocalPlayerData.Movement
	local state = movementData and movementData.State
	if not state then
		state = self.State
	end
	local grounded = self.DataRegistry:Get("Grounded")
	-- JoblessHub Bhop Mode "No Ground Check": bhop no longer depends solely on the
	-- registry "Grounded" flag (the check that blocks bhop when the character is
	-- CONSIDERED not touching the ground). The humanoid's own physics state is used
	-- as a fallback, so the registry can no longer block the jump. Original modes
	-- keep using the registry value exactly like DaraHub did.
	local bhopGrounded = grounded
	if ConfigState.accelerationMethod == "No Ground Check" and (ConfigState.autoJumpEnabled or ConfigState.bhopHoldEnabled) then
		local nativeGrounded = humanoid.FloorMaterial ~= Enum.Material.Air or humanoid:GetState() == Enum.HumanoidStateType.Landed
		bhopGrounded = grounded or nativeGrounded
	end
	local desiredFriction = nil
	local isInfSlide = (state == "Slide" or state == "EmotingSlide" or state == "CarrySlide")
	local isEmoteSlideAccel = (state == "EmotingSlide")
	if isInfSlide then
		if ConfigState.infiniteSlide then
			desiredFriction = ConfigState.slideFriction
		end
	end
	if isEmoteSlideAccel then
		if ConfigState.emoteSpeedEnabled and ConfigState.emoteSpeedType == "Legit" then
			desiredFriction = ConfigState.emoteAccelerationValue
		end
	end
	if desiredFriction == nil and (ConfigState.accelerationMethod == "Acceleration" or ConfigState.accelerationMethod == "No Ground Check") then
		local isBhopActive = ConfigState.autoJumpEnabled or (ConfigState.bhopHoldEnabled and humanoid.Jump == true)
		if isBhopActive and not bhopGrounded then
			local currentSpeed = GetCharacterHorizontalSpeed(self.Character)
			if ConfigState.autoAccelerationEnabled then
				if currentSpeed > ConfigState.maxAutoAccelSpeed then
					desiredFriction = ConfigState.maxAcceleration
				elseif currentSpeed < ConfigState.maxAutoAccelSpeed then
					desiredFriction = ConfigState.minAcceleration
				else
					desiredFriction = ConfigState.accelerationValue
				end
			else
				desiredFriction = ConfigState.accelerationValue
			end
		end
	end
	if desiredFriction ~= ConfigState.lastFriction then
		if desiredFriction ~= nil then
			SetCharacterMovementValue("Friction", desiredFriction)
		else
			SetCharacterMovementValue("Friction", ConfigState.defaultMovementValues.Friction)
		end
		ConfigState.lastFriction = desiredFriction
	end
	if (state == "WallrunRight" or state == "WallrunLeft") and ConfigState.AutowallHop then
		self:AttemptJump()
	end
	if ConfigState.autoJumpEnabled and bhopGrounded then
		if ConfigState.autoJumpType == "Realistic" then
			self:AttemptJump()
		else
			humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
		end
	end
	if ConfigState.bhopHoldEnabled and bhopGrounded and humanoid.Jump == true then
		self:AttemptJump()
	end
end
