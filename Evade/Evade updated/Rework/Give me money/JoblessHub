				local meta = eventMeta[key]
				local id = tonumber(key)
				if not meta or not id or meta.State == "Locked" or meta.Owned or PlayerData.Owns(id) then
					return false
				end
				if not meta.Price or PlayerData.Tickets() < meta.Price then
					return false
				end
				return PlayerData.Purchase(id)
