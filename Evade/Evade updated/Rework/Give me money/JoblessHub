function GetRoundTitle(roundName)
	if not roundName or roundName == "" then
		return ""
	end
	local specialRoundsFolder = ReplicatedStorage:FindFirstChild("Info")
	if not specialRoundsFolder then
		return roundName
	end
	specialRoundsFolder = specialRoundsFolder:FindFirstChild("SpecialRounds")
	if not specialRoundsFolder then
		return roundName
	end
	local roundModule = specialRoundsFolder:FindFirstChild(roundName)
	if not roundModule then
		return roundName
	end
	local moduleData = require(roundModule)
	if moduleData and moduleData.Title then
		return moduleData.Title
	end
	return roundName
end
function SetTime(seconds)
	if not ConfigState.TimerGUI then
		return
	end
	if type(seconds) == "number" then
		local minutes = math.floor(seconds / 60)
		local remainingSeconds = math.floor(seconds % 60)
		ConfigState.TimerGUI.TimeDisplay.Text = string.format("%d:%02d", minutes, remainingSeconds)
		if seconds <= 5 then
			ConfigState.TimerGUI.TimeDisplay.TextColor3 = Color3.fromRGB(215, 100, 100)
			ConfigState.TimerGUI.StatusLabel.TextColor3 = Color3.fromRGB(215, 100, 100)
			if ConfigState.TimerGUI.MainTimerStroke then
				ConfigState.TimerGUI.MainTimerStroke.Color = Color3.fromRGB(255, 138, 138)
			end
			if ConfigState.TimerGUI.MainTimerImage then
				ConfigState.TimerGUI.MainTimerImage.ImageColor3 = Color3.fromRGB(255, 138, 138)
			end
		else
			ConfigState.TimerGUI.TimeDisplay.TextColor3 = Color3.fromRGB(165, 194, 255)
			ConfigState.TimerGUI.StatusLabel.TextColor3 = Color3.fromRGB(165, 194, 255)
			if ConfigState.TimerGUI.MainTimerStroke then
				ConfigState.TimerGUI.MainTimerStroke.Color = Color3.fromRGB(165, 194, 255)
			end
			if ConfigState.TimerGUI.MainTimerImage then
				ConfigState.TimerGUI.MainTimerImage.ImageColor3 = Color3.fromRGB(21, 21, 21)
			end
		end
	else
		ConfigState.TimerGUI.TimeDisplay.Text = tostring(seconds)
	end
