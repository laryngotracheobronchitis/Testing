			local function stopLoop(key)
				if loops[key] then
					loops[key]()
					loops[key] = nil
				end
			end
			local function configOf(key)
				local id = tonumber(key)
				if not id then
					return nil
				end
				return ItemRegistry.GetConfig(id)
			end
			local function nameOf(key)
				local config = configOf(key)
				if config and config.AppearanceInfo and config.AppearanceInfo.Name then
					return config.AppearanceInfo.Name
				end
				local entry = ItemRegistry.TryGetById(tonumber(key))
				if entry and entry.Module then
					return entry.Module.Name
				end
				return "Item " .. key
			end
			local function isMultiple(key)
				local config = configOf(key)
				return config ~= nil and config.PurchaseInfo ~= nil and config.PurchaseInfo.OwnershipType == "Multiple"
			end
			local function playerLevel()
				local ok, progress = pcall(PlayerData.Progression)
				if ok and type(progress) == "table" then
					return tonumber(progress.Level) or 0
				end
				return 0
			end
			local function levelRequirementOf(key)
				local config = configOf(key)
				local purchase = config and config.PurchaseInfo
				return tonumber(purchase and purchase.LevelRequirement) or 0
			end
			local function meetsLevel(key)
				return playerLevel() >= levelRequirementOf(key)
			end
			local function overviewOf(key)
				local config = configOf(key)
				local ui = config and config.UIInfo
				return tostring(ui and ui.Overview or "Other")
			end
			local function ownedCountOf(key)
				local id = tonumber(key)
				local function try(fn)
					local ok, value = pcall(fn)
					if ok and type(value) == "number" then
						return value
					end
					return nil
				end
				local record = PlayerData.StockRecord(key)
				if type(record) == "table" then
					for _, field in ipairs({"OwnedAmount", "OwnedCount", "Owned", "Count", "Amount"}) do
						if type(record[field]) == "number" then
							return record[field]
						end
					end
				end
				if id then
					local inventory = CosmeticModules.InventoryService
					for _, method in ipairs({"Count", "GetCount", "Amount", "GetAmount", "Quantity", "GetQuantity"}) do
						local fn = inventory and inventory[method]
						if type(fn) == "function" then
							local value = try(function()
								return fn(id)
							end)
							if value then
								return value
							end
						end
					end
				end
				return PlayerData.OwnsStock(key) and 1 or 0
			end
			local eventMeta = {}
