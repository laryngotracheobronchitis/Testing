-- yang membuat seluruh script gagal dimuat; ditangkap oleh simulator runtime).
local function tryFireConnection(c, ...)
local okFn, fn = pcall(function() return c.Function end)
if okFn and type(fn) == "function" then
if pcall(fn, ...) then
return true
end
