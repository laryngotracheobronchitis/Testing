function SelfRevive:Respawn()
local now = tick()
if now - SelfRevive.LastRespawnTime < 0.5 then
return
end
SelfRevive.LastRespawnTime = now

if SelfRevive.IsProcessing then
return
end

local char = LocalPlayer.Character
if not char then
