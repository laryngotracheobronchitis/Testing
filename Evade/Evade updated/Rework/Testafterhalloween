local frame = darahubGui:FindFirstChild(flagName)
if frame then
frame.Size = UDim2.new(0, screenWidth, 0, screenHeight)

local uiScale = frame:FindFirstChildOfClass("UIScale")
if uiScale then
if screenButtonBaseScale[flagName] == nil then
screenButtonBaseScale[flagName] = uiScale.Scale
end
uiScale.Scale = screenButtonBaseScale[flagName] * screenScale
end
end
end)
end
end

