do
local screenButtonFlags = { "SuperBounce", "BunnyHopToggle", "LagSwitch" }
local screenButtonBaseScale = {}
local screenWidth, screenHeight, screenScale = 250, 90, 1

local function applyScreenButtonSize()
local okGui, darahubGui = pcall(function()
return game:GetService("CoreGui"):FindFirstChild("Darahub")
end)
if not okGui or not darahubGui then return end

for _, flagName in ipairs(screenButtonFlags) do
