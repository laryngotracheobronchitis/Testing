            task.wait(duration)
            TweenService:Create(LineBottom, TweenInfo.new(duration, Enum.EasingStyle.Linear), {Size = UDim2.new(1, 0, 0, 1)}):Play()
            task.wait(duration)
            TweenService:Create(LineLeft, TweenInfo.new(duration, Enum.EasingStyle.Linear), {Size = UDim2.new(0, 1, 1, 0)}):Play()
