-- ============================================================
local function performDemonLag()
    local RISE_HEIGHT = tonumber(DemonHeightBox.Text) or getgenv().DemonRiseHeight or 100
    local BOOST_SPEED = tonumber(DemonSpeedBox.Text) or getgenv().DemonRiseSpeed or 80

    task.spawn(function()
        local startLagTime = tick()
        while tick() - startLagTime < FreezeDuration do
            for i = 1, 500000 do
                local a = math.random(1, 1000000) * math.random(1, 1000000)
                a = a / math.random(1, 10000)
                local b = math.sqrt(math.random(1, 1000000))
                b = b * math.pi * math.exp(1)
            end
        end
    end)

    local character = Player.Character
    if character then
        local hrp = character:FindFirstChild("HumanoidRootPart")
        local humanoid = character:FindFirstChild("Humanoid")
        if hrp and humanoid then
            local startHeight = hrp.Position.Y

            local bodyThrust = Instance.new("BodyThrust")
            bodyThrust.Name = "DemonRiseThrust"
            bodyThrust.Force = Vector3.new(0, BOOST_SPEED * 500, 0)
            bodyThrust.Location = Vector3.new(0, 0, 0)
            bodyThrust.Parent = hrp

            local bodyVelocity = Instance.new("BodyVelocity")
            bodyVelocity.Name = "DemonRiseVelocity"
            bodyVelocity.MaxForce = Vector3.new(0, 500000, 0)
            bodyVelocity.Velocity = Vector3.new(0, BOOST_SPEED, 0)
            bodyVelocity.Parent = hrp

            local waitTime = 0
            while waitTime < 5 do
                if hrp.Position.Y - startHeight >= RISE_HEIGHT then break end
                task.wait(0.1)
                waitTime += 0.1
            end

            bodyThrust:Destroy()
            bodyVelocity:Destroy()
        end
    end
end

