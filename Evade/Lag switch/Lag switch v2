local function PerformFreeze()
    if IsFreezing then return end
    if tick() - LastFreezeTime < Cooldown then return end

    IsFreezing = true
    LastFreezeTime = tick()

    if lagSwitchMode == "Demon" then
        ButtonText.Text = "DEMON"
        StatusText.Text = "RISING"
        StatusText.TextColor3 = Color3.fromRGB(200, 50, 255)
        CyberBorder.Color = Color3.fromRGB(200, 0, 255)
        if fflagEnabled then SetFFlag(1000) end
        task.spawn(function()
            performDemonLag()
            ButtonText.Text = originalMainText
            StatusText.Text = originalStatusText
            StatusText.TextColor3 = Color3.fromRGB(100, 255, 255)
            CyberBorder.Color = Color3.fromRGB(0, 255, 255)
            if fflagEnabled then SetFFlag(1000) end
            IsFreezing = false
        end)
    else
        ButtonText.Text = "FREEZING"
        StatusText.Text = "BUSY"
        StatusText.TextColor3 = Color3.fromRGB(255, 50, 50)
        CyberBorder.Color = Color3.fromRGB(255, 0, 0)
        if fflagEnabled then SetFFlag(1000) end
        task.wait(0.05)
        local startTime = os.clock()
        while os.clock() - startTime < FreezeDuration do end
        ButtonText.Text = originalMainText
        StatusText.Text = originalStatusText
        StatusText.TextColor3 = Color3.fromRGB(100, 255, 255)
        CyberBorder.Color = Color3.fromRGB(0, 255, 255)
        if fflagEnabled then SetFFlag(1000) end
        IsFreezing = false
    end
end

