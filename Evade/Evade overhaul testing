            TweenService:Create(LagLineTop, TweenInfo.new(d, Enum.EasingStyle.Linear), {Size = UDim2.new(1,0,0,1)}):Play(); task.wait(d)
            TweenService:Create(LagLineRight, TweenInfo.new(d, Enum.EasingStyle.Linear), {Size = UDim2.new(0,1,1,0)}):Play(); task.wait(d)
            TweenService:Create(LagLineBottom, TweenInfo.new(d, Enum.EasingStyle.Linear), {Size = UDim2.new(1,0,0,1)}):Play(); task.wait(d)
            TweenService:Create(LagLineLeft, TweenInfo.new(d, Enum.EasingStyle.Linear), {Size = UDim2.new(0,1,1,0)}):Play(); task.wait(d)
            LagLineTop.Size = UDim2.new(0,0,0,1); LagLineRight.Size = UDim2.new(0,1,0,0)
