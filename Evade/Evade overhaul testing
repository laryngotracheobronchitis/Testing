local ToolAction = ReplicatedStorage.Events.Character.ToolAction
local SpeedBoostEvent = ReplicatedStorage.Events.Character.SpeedBoost
local firstFired = false
local ColaCheat = { UnlimitedCola = false, CustomSpeed = 1.4, CustomDuration = 3.5, isBlocked = false }

local mt = getrawmetatable(ToolAction)
local oldNamecall = mt.__namecall
setreadonly(mt, false)

mt.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    local args = { ... }

    if method == "FireServer" and self == ToolAction then
        if args[1] == 0 then
            firstFired = true
            task.delay(0.5, function()
                if ColaCheat.CustomSpeed and ColaCheat.CustomDuration then
                    firesignal(SpeedBoostEvent.OnClientEvent, "Drink", ColaCheat.CustomSpeed, ColaCheat.CustomDuration, Color3.new(1, 1, 1))
                end
            end)
        elseif firstFired and args[1] == 2 then
            firstFired = false
            if ColaCheat.UnlimitedCola then
                ColaCheat.isBlocked = true
                task.delay(5, function() ColaCheat.isBlocked = false end)
            end
        end
        if ColaCheat.UnlimitedCola and ColaCheat.isBlocked and args[1] == 2 then return nil end
    end
    return oldNamecall(self, ...)
end)
setreadonly(mt, true)


