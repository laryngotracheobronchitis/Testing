local function LagPlayBoot()
    for i = 1, 2 do
        IceButton.BackgroundTransparency = 0.5; task.wait(0.1)
        IceButton.BackgroundTransparency = 0.3; task.wait(0.1)
    end
    LagScannerLine.Visible = true
    local sw = TweenService:Create(LagScannerLine, TweenInfo.new(0.6, Enum.EasingStyle.Quad), {Position = UDim2.new(1,10,0,0)})
    sw:Play()
    sw.Completed:Connect(function() LagScannerLine.Visible = false; LagScannerLine.Position = UDim2.new(0,-10,0,0) end)
    local function typeIt(lbl, txt, d)
        lbl.Text = ""
        for i = 1, #txt do lbl.Text = string.sub(txt,1,i); task.wait(d) end
    end
    task.wait(0.3); task.spawn(typeIt, LagButtonText, LagOriginalMainText, 0.1)
    task.wait(0.3); task.spawn(typeIt, LagStatusText, LagOriginalStatusText, 0.05)
end

local function LagStartIdle()
    coroutine.wrap(function()
        while IceButton and IceButton.Parent do
            local i = TweenService:Create(LagCyberBorder, TweenInfo.new(3, Enum.EasingStyle.Sine), {Color = Color3.fromRGB(100,255,255)})
            local o = TweenService:Create(LagCyberBorder, TweenInfo.new(3, Enum.EasingStyle.Sine), {Color = Color3.fromRGB(0,150,255)})
            i:Play(); i.Completed:Wait(); o:Play(); o.Completed:Wait()
        end
    end)()
    coroutine.wrap(function()
        while IceButton and IceButton.Parent do
            local i = TweenService:Create(LagButtonText, TweenInfo.new(2, Enum.EasingStyle.Sine), {TextStrokeTransparency = 0.1})
            local o = TweenService:Create(LagButtonText, TweenInfo.new(2, Enum.EasingStyle.Sine), {TextStrokeTransparency = 0.3})
            i:Play(); i.Completed:Wait(); o:Play(); o.Completed:Wait()
        end
    end)()
    coroutine.wrap(function()
        while IceButton and IceButton.Parent do
            local i = TweenService:Create(LagGlowEffect, TweenInfo.new(3, Enum.EasingStyle.Sine), {ImageTransparency = 0.6})
            local o = TweenService:Create(LagGlowEffect, TweenInfo.new(3, Enum.EasingStyle.Sine), {ImageTransparency = 0.8})
            i:Play(); i.Completed:Wait(); o:Play(); o.Completed:Wait()
        end
    end)()
end

