-- 3. MOVEMENT MODIFICATIONS & BHOP LOGIC
-- ==============================================================================
local m = require(game.ReplicatedStorage.Modules.Character.CharacterTable.CharacterController.Local.Movement.returnValues)
local originalGetStats = m.getStats
local movementInstances = {}

local savedMovementStats = {
    AirStrafeAcceleration = 182,
    JumpCap = 1
}

local autoJumpEnabled = false
local bhopHoldActive = false
local accelerationMethod = "Acceleration"
local accelerationValue = -0.2
local Bhop = false
local BhopHold = false
local bhopLoaded = false
local bhopConnection = nil
local Character, Humanoid, HumanoidRootPart = nil, nil, nil

local function findMovementInstances()
    movementInstances = {}
    for _, v in pairs(getgc(true)) do
        if type(v) == "table" and rawget(v, "defaultMovementStats") then
            table.insert(movementInstances, v)
        end
    end
    return #movementInstances > 0
end

local function applySavedMovementStats()
    task.spawn(function()
        for i = 1, 10 do
            task.wait(0.5)
            if findMovementInstances() then
                for _, instance in ipairs(movementInstances) do
                    if instance and instance.overrideMovementStats then
                        instance.overrideMovementStats["AirStrafeAcceleration"] = tonumber(savedMovementStats.AirStrafeAcceleration)
                        instance.overrideMovementStats["JumpCap"] = tonumber(savedMovementStats.JumpCap)
                    end
                end
                break
            end
        end
    end)
end

local function IsOnGround()
    if not Character or not HumanoidRootPart or not Humanoid then return false end
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
    raycastParams.FilterDescendantsInstances = {Character}
    local rayOrigin = HumanoidRootPart.Position
    local raycastResult = workspace:Raycast(rayOrigin, Vector3.new(0, -3.5, 0), raycastParams)
    
    if not raycastResult then return false end
    local angle = math.deg(math.acos(raycastResult.Normal:Dot(Vector3.new(0, 1, 0))))
    return angle <= 45
end

local function updateBhop()
    if not bhopLoaded then return end
    Character = player.Character
    Humanoid = Character and Character:FindFirstChild("Humanoid")
    HumanoidRootPart = Character and Character:FindFirstChild("HumanoidRootPart")
    if not Character or not Humanoid then return end

    if (autoJumpEnabled or bhopHoldActive) and IsOnGround() then
        Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    end
end

local function checkBhopState()
    if autoJumpEnabled or bhopHoldActive then
        if not bhopLoaded then
            bhopLoaded = true
            bhopConnection = RunService.Heartbeat:Connect(updateBhop)
        end
    else
        bhopLoaded = false
        if bhopConnection then bhopConnection:Disconnect() bhopConnection = nil end
    end
end

local function setupJumpButton()
    pcall(function()
        local touchGui = player:WaitForChild("PlayerGui", 5):WaitForChild("TouchGui", 5)
        local jumpButton = touchGui:WaitForChild("TouchControlFrame", 5):WaitForChild("JumpButton", 5)
        if not jumpButton then return end
        jumpButton.MouseButton1Down:Connect(function() if BhopHold then bhopHoldActive = true checkBhopState() end end)
        jumpButton.MouseButton1Up:Connect(function() bhopHoldActive = false checkBhopState() end)
    end)
end

player.CharacterAdded:Connect(function(char)
    Character = char
    setupJumpButton()
    applySavedMovementStats() 
    if autoJumpEnabled or bhopHoldActive then
        task.wait(0.5)
        checkBhopState()
    end
end)

m.getStats = function(s, p)
    local v = originalGetStats(s, p)
    local isBhopActive = autoJumpEnabled or bhopHoldActive
    v.BhopEnabled = isBhopActive
    if isBhopActive then
        if accelerationMethod == "Ground Acceleration" then
            v.Friction = s:checkGrounded() and accelerationValue or 5
        elseif accelerationMethod == "Acceleration" then
            v.Friction = accelerationValue
        else
            v.Friction = 5
        end
    else
        v.Friction = 5
    end
    return v
end

