local function lagUpdateDrag(input)
    local delta = input.Position - lagDragStart
    IceButton.Position = UDim2.new(lagStartPos.X.Scale, lagStartPos.X.Offset + delta.X, lagStartPos.Y.Scale, lagStartPos.Y.Offset + delta.Y)
end

local function lagStartDrag(input)
    if not LagDragEnabled or lagDragging then return end
    local objects = PlayerGui:GetGuiObjectsAtPosition(input.Position.X, input.Position.Y)
    local canDrag = false
    for _, obj in ipairs(objects) do
        if obj:IsDescendantOf(IceButton) and obj ~= LagSettingsButton and obj ~= LagSettingsPanel then
            canDrag = true; break
        end
    end
    if canDrag then
        lagDragging = true
        lagDragInput = input
        lagDragStart = input.Position
        lagStartPos = IceButton.Position
        if input.UserInputType == Enum.UserInputType.Touch then
            lagDragConnection = UserInputService.TouchMoved:Connect(function(t)
                if t == input and lagDragging then lagUpdateDrag(t) end
            end)
            UserInputService.TouchEnded:Connect(function(t)
                if t == input then
                    lagDragging = false
                    if lagDragConnection then lagDragConnection:Disconnect(); lagDragConnection = nil end
                end
            end)
        else
            local c; c = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    lagDragging = false; c:Disconnect()
                end
            end)
        end
    end
end

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        lagStartDrag(input)
    end
end)

UserInputService.InputChanged:Connect(function(input, gp)
    if gp then return end
    if lagDragging and input == lagDragInput and input.UserInputType == Enum.UserInputType.MouseMovement then
        lagUpdateDrag(input)
    end
end)

