local function PerformFreeze()
    if LagIsFreezing then return end
    if tick() - LagLastFreezeTime < LagCooldown then return end
    LagIsFreezing = true; LagLastFreezeTime = tick()
    if LagSwitchMode == "Demon" then
        LagButtonText.Text = "DEMON"; LagStatusText.Text = "RISING"
        LagStatusText.TextColor3 = Color3.fromRGB(200,50,255); LagCyberBorder.Color = Color3.fromRGB(200,0,255)
        if LagFflagEnabled then SetFFlag(1000) end
        task.spawn(function()
            performDemonLag()
            LagButtonText.Text = LagOriginalMainText; LagStatusText.Text = LagOriginalStatusText
            LagStatusText.TextColor3 = Color3.fromRGB(100,255,255); LagCyberBorder.Color = Color3.fromRGB(0,255,255)
            if LagFflagEnabled then SetFFlag(1000) end; LagIsFreezing = false
        end)
    else
        LagButtonText.Text = "FREEZING"; LagStatusText.Text = "BUSY"
        LagStatusText.TextColor3 = Color3.fromRGB(255,50,50); LagCyberBorder.Color = Color3.fromRGB(255,0,0)
        if LagFflagEnabled then SetFFlag(1000) end
        task.wait(0.05)
        local t = os.clock(); while os.clock() - t < LagFreezeDuration do end
        LagButtonText.Text = LagOriginalMainText; LagStatusText.Text = LagOriginalStatusText
        LagStatusText.TextColor3 = Color3.fromRGB(100,255,255); LagCyberBorder.Color = Color3.fromRGB(0,255,255)
        if LagFflagEnabled then SetFFlag(1000) end; LagIsFreezing = false
    end
end

