-- Demon Mode logic
local function performDemonLag()
    local RISE_HEIGHT = tonumber(DemonHeightBox.Text) or getgenv().DemonRiseHeight or 100
    local BOOST_SPEED = tonumber(DemonSpeedBox.Text) or getgenv().DemonRiseSpeed or 80
    task.spawn(function()
        local t = tick()
        while tick() - t < LagFreezeDuration do
            for i = 1, 500000 do
                local a = math.random(1,1000000) * math.random(1,1000000)
                a = a / math.random(1,10000)
                local b = math.sqrt(math.random(1,1000000)) * math.pi * math.exp(1)
            end
        end
    end)
    local character = player.Character
    if character then
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if hrp then
            local startY = hrp.Position.Y
            local bv = Instance.new("BodyVelocity")
            bv.MaxForce = Vector3.new(0, 500000, 0)
            bv.Velocity = Vector3.new(0, BOOST_SPEED, 0)
            bv.Parent = hrp
            local bt = Instance.new("BodyThrust")
            bt.Force = Vector3.new(0, BOOST_SPEED * 500, 0)
            bt.Parent = hrp
            local waited = 0
            while waited < 5 do
                if hrp.Position.Y - startY >= RISE_HEIGHT then break end
                task.wait(0.1); waited += 0.1
            end
            bv:Destroy(); bt:Destroy()
        end
    end
end

