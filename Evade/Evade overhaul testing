local ToolAction = ReplicatedStorage.Events.Character.ToolAction
local SpeedBoostEvent = ReplicatedStorage.Events.Character.SpeedBoost
local ColaTool = ReplicatedStorage.Tools:FindFirstChild("Cola")
local ColaModule = ColaTool and require(ReplicatedStorage.Tools.Cola) or nil
local ColaModuleTag = ColaTool and ColaTool:GetAttribute("Tag") or nil
local firstFired = false

local ColaCheat = {
    UnlimitedCola = false,
    ModifyStats = true,
    CustomSpeed = 1.4,
    CustomDuration = 3.5,
    BlockDuration = 5,
    isBlocked = false
}

local function GetDrinkDelay()
    if not ColaModule then return 0.5 end
    local Tasks = ColaModule.Tasks
    if Tasks and type(Tasks) == "table" then
        for _, task in ipairs(Tasks) do
            local AutomaticFunctions = task.AutomaticFunctions
            if AutomaticFunctions and type(AutomaticFunctions) == "table" then
                for _, func in ipairs(AutomaticFunctions) do
                    if func.Phrase == "StartDrinking" then
                        local Methods = func.Methods
                        if Methods and type(Methods) == "table" then
                            for _, method in ipairs(Methods) do
                                local Info = method.Info
                                if Info and Info.Cooldown then
                                    return Info.Cooldown
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return 0.5
end

local function GetSpeedBoostData()
    if not ColaModule then return ColaCheat.CustomSpeed, ColaCheat.CustomDuration, Color3.new(1,1,1) end
    local Tasks = ColaModule.Tasks
    if Tasks and type(Tasks) == "table" then
        for _, task in ipairs(Tasks) do
            local AutomaticFunctions = task.AutomaticFunctions
            if AutomaticFunctions and type(AutomaticFunctions) == "table" then
                for _, func in ipairs(AutomaticFunctions) do
                    if func.Phrase == "FinishDrink" then
                        local Methods = func.Methods
                        if Methods and type(Methods) == "table" then
                            for _, method in ipairs(Methods) do
                                local Info = method.Info
                                if Info then
                                    return ColaCheat.CustomSpeed, ColaCheat.CustomDuration, Info.Color
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return ColaCheat.CustomSpeed, ColaCheat.CustomDuration, Color3.new(1,1,1)
end

local function fakecolaspeed()
    local speed, duration, color = GetSpeedBoostData()
    if speed and duration then
        local args = {
            [1] = "Drink",
            [2] = speed,
            [3] = duration,
            [4] = color
        }
        firesignal(SpeedBoostEvent.OnClientEvent, unpack(args))
    end
end

local mt = getrawmetatable(ToolAction)
local oldNamecall = mt.__namecall
setreadonly(mt, false)

mt.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    local args = {...}

    if method == "FireServer" and self == ToolAction then
        if args[1] == 0 and args[2] == ColaModuleTag then
            firstFired = true
            local delay = GetDrinkDelay()
            if delay then
                task.delay(delay, function()
                    fakecolaspeed()
                end)
            end
        elseif firstFired and args[1] == 2 then
            firstFired = false
            if ColaCheat.UnlimitedCola then
                ColaCheat.isBlocked = true
                task.delay(ColaCheat.BlockDuration, function()
                    ColaCheat.isBlocked = false
                end)
            end
        end

        if ColaCheat.UnlimitedCola and ColaCheat.isBlocked and args[1] == 2 then
            return nil
        end
    end

    return oldNamecall(self, ...)
end)
setreadonly(mt, true)

