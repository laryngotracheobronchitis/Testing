m.getStats = function(s, p)
    local v = originalGetStats(s, p)
    local isBhopActive = autoJumpEnabled or bhopHoldActive
    v.BhopEnabled = isBhopActive
    
    if isBhopActive and (accelerationMethod == "Ground Acceleration" or accelerationMethod == "Acceleration") then
        if accelerationMethod == "No Acceleration" then
            v.Friction = 5
        elseif accelerationMethod == "Ground Acceleration" then
            v.Friction = s:checkGrounded() and accelerationValue or 5
        elseif accelerationMethod == "Acceleration" then
            v.Friction = accelerationValue
        end
    else
        v.Friction = 5
    end
    return v
end

