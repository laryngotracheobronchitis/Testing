local movementRequiredFields = {
    Friction = true,
    AirStrafeAcceleration = true,
    JumpHeight = true,
    RunDeaccel = true,
    JumpSpeedMultiplier = true,
    JumpCap = true,
    SprintCap = true,
    WalkSpeedMultiplier = true,
    BhopEnabled = true,
    Speed = true,
    AirAcceleration = true,
    RunAccel = true,
    SprintAcceleration = true
}

local function hasAllMovementFields(tbl)
    if type(tbl) ~= "table" then return false end
    for field, _ in pairs(movementRequiredFields) do
        if rawget(tbl, field) == nil then return false end
    end
    return true
end

local function getConfigTables()
    local tables = {}
    for _, obj in ipairs(getgc(true)) do
        local success, result = pcall(function()
            if hasAllMovementFields(obj) then return obj end
        end)
        if success and result then
            table.insert(tables, result)
        end
    end
    return tables
end

local function applyToTables(callback)
    local targets = getConfigTables()
    if #targets == 0 then return end
    for _, tableObj in ipairs(targets) do
        if tableObj and typeof(tableObj) == "table" then
            pcall(callback, tableObj)
        end
    end
end

local function applySavedMovementStats()
    applyToTables(function(obj)
        obj.AirStrafeAcceleration = tonumber(savedMovementStats.AirStrafeAcceleration)
        obj.JumpCap = tonumber(savedMovementStats.JumpCap)
    end)
end

player.CharacterAdded:Connect(function(character)
