-- ==============================================================================
-- LAG SWITCH (ButtonLib, Normal + Demon Mode, Draconic-faithful)
-- ==============================================================================
local lagSwitchEnabled = false
local lagSwitchMode    = "Normal"
local isLagActive      = false
local lagDelayValue    = 0.1
local lagIntensity     = 1000000

getgenv().DemonRiseHeight  = 10
getgenv().DemonRiseSpeed   = 80
getgenv().DemonSoftLanding = true

-- ── Normal lag (blocking math loop) ──────────────────────────────────────────
local function performMathLag()
    local startTime = tick()
    while tick() - startTime < lagDelayValue do
        for i = 1, lagIntensity do
            local a = math.random(1, 1000000) * math.random(1, 1000000)
            a = a / math.random(1, 10000)
            local b = math.sqrt(math.random(1, 1000000))
            b = b * math.pi * math.exp(1)
            local c = math.sin(math.rad(math.random(1, 360))) * math.cos(math.rad(math.random(1, 360)))
        end
    end
end

-- ── Demon lag (math in background + rise, identical to Draconic) ─────────────
local function performDemonLag()
    local RISE_HEIGHT = getgenv().DemonRiseHeight or 10
    local BOOST_SPEED = getgenv().DemonRiseSpeed  or 80

    -- Bagian 1: math lag di background
    task.spawn(function()
        local startLagTime = tick()
        while tick() - startLagTime < lagDelayValue do
            for i = 1, math.floor(lagIntensity / 2) do
                local a = math.random(1, 1000000) * math.random(1, 1000000)
                a = a / math.random(1, 10000)
                local b = math.sqrt(math.random(1, 1000000))
                b = b * math.pi * math.exp(1)
            end
        end
    end)

    -- Bagian 2: naikan karakter (blocking di thread ini)
    local character = player.Character
    if character then
        local hrp      = character:FindFirstChild("HumanoidRootPart")
        local humanoid = character:FindFirstChild("Humanoid")

        if hrp and humanoid then
            local startHeight = hrp.Position.Y

            local bodyThrust = Instance.new("BodyThrust")
            bodyThrust.Name     = "DemonRiseThrust"
            bodyThrust.Force    = Vector3.new(0, BOOST_SPEED * 500, 0)
            bodyThrust.Location = Vector3.new(0, 0, 0)
            bodyThrust.Parent   = hrp

            local bodyVelocity = Instance.new("BodyVelocity")
            bodyVelocity.Name      = "DemonRiseVelocity"
            bodyVelocity.MaxForce  = Vector3.new(0, 500000, 0)
            bodyVelocity.Velocity  = Vector3.new(0, BOOST_SPEED, 0)
            bodyVelocity.Parent    = hrp

            local waitTime   = 0
            local maxWait    = 5
            while waitTime < maxWait do
                if hrp.Position.Y - startHeight >= RISE_HEIGHT then break end
                task.wait(0.1)
                waitTime += 0.1
            end

            bodyThrust:Destroy()
            bodyVelocity:Destroy()
        end
    end

    isLagActive = false
end

-- ── Toggle dispatcher (sama persis Draconic) ─────────────────────────────────
local function toggleLagSwitch()
    if not isLagActive then
        isLagActive = true
        if lagSwitchMode == "Normal" then
            task.spawn(function()
                performMathLag()
                isLagActive = false
            end)
        elseif lagSwitchMode == "Demon" then
            task.spawn(function()
                performDemonLag()
                isLagActive = false
            end)
        end
    end
end

-- ── Button creator (sama pola Draconic: destroy jika ada, create jika tidak) ──
function createLagSwitchButton()
    local existingGui = CoreGui:FindFirstChild("LagSwitchButtonGUI")

    if existingGui then
        existingGui:Destroy()
        return
    end

    if not lagSwitchEnabled then return end

    -- ── Main button (ButtonLib.Create:Button) ─────────────────────────────
    local lagBtn = ButtonLib.Create:Button({
        Flag     = "LagSwitchBtn",
        Text     = "Lag Switch : NORMAL",
        Position = UDim2.new(0.5, -125, 0.5, 0),
        Visible  = true,
        Callback = function()
            toggleLagSwitch()
        end,
    })

    -- Simpan ref ke CoreGui ScreenGui agar bisa di-destroy
    local lagGui = CoreGui:FindFirstChild("Darahub")
    -- Buat wrapper ScreenGui khusus untuk destroy tracking
    local wrapGui = Instance.new("ScreenGui")
    wrapGui.Name          = "LagSwitchButtonGUI"
    wrapGui.ResetOnSpawn  = false
    wrapGui.Parent        = CoreGui

    -- ── Mode toggle button ────────────────────────────────────────────────
    local modeBtn = ButtonLib.Create:Button({
        Flag     = "LagSwitchModeBtn",
        Text     = "Mode : NORMAL",
        Position = UDim2.new(0.5, -125, 0.5, 100),
        Visible  = true,
        Callback = function()
            if lagSwitchMode == "Normal" then
                lagSwitchMode = "Demon"
            else
                lagSwitchMode = "Normal"
            end
            -- Update teks kedua button
            local lagFrame  = _G.DarahubLibBtn["LagSwitchBtn"]
            local modeFrame = _G.DarahubLibBtn["LagSwitchModeBtn"]
            if lagFrame  then lagFrame.Label.Text  = "Lag Switch : " .. lagSwitchMode:upper() end
            if modeFrame then modeFrame.Label.Text = "Mode : "        .. lagSwitchMode:upper() end
        end,
    })

    -- Hapus kedua button saat wrapper di-destroy
    wrapGui.AncestryChanged:Connect(function()
        if not wrapGui.Parent then
            pcall(function() _G.DarahubLibBtn["LagSwitchBtn"]:Destroy() end)
            pcall(function() _G.DarahubLibBtn["LagSwitchModeBtn"]:Destroy() end)
        end
    end)
end

