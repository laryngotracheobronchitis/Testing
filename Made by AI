-- AIMBOT (ADAPTED FROM DARA HUB - 100% MOBILE FRIENDLY)
-- Fitur: 1 Tombol (30x30), FOV 5 (Visible Center), Smoothness 30, Wall Check, Auto Team Check

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Teams = game:GetService("Teams")
local Workspace = game:GetService("Workspace")
local CoreGui = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera

-- ==================== PENGATURAN ====================
local FOV_RADIUS = 5
local SMOOTHNESS_VALUE = 30 -- Mengikuti sistem Darahub (semakin tinggi semakin halus)
local AIMBOT_ACTIVE = false
local currentTarget = nil
local wallCheckEnabled = true -- Selalu aktif

-- ==================== AUTO TEAM CHECK SYSTEM ====================
local function isTeamGame()
    local activeTeams = Teams:GetTeams()
    local validTeamCount = 0
    
    for _, team in ipairs(activeTeams) do
        if team.Name ~= "Spectators" and #team:GetPlayers() > 0 then
            validTeamCount = validTeamCount + 1
        end
    end
    return validTeamCount > 1
end

local function canTargetPlayer(targetPlayer)
    if targetPlayer == LocalPlayer then return false end
    
    if isTeamGame() then
        if LocalPlayer.Team ~= nil and targetPlayer.Team == LocalPlayer.Team then
            return false -- Rekan satu tim
        else
            return true -- Musuh
        end
    else
        return true -- Mode FFA, semua musuh
    end
end

-- ==================== UI SETUP (MOBILE FRIENDLY) ====================
local parentGui = (gethui and gethui()) or CoreGui

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "DaraAimbotMobileUI"
screenGui.Parent = parentGui
screenGui.ResetOnSpawn = false
screenGui.IgnoreGuiInset = true

-- Tombol 30x30 di pojok kiri atas (0,0)
local toggleBtn = Instance.new("TextButton")
toggleBtn.Size = UDim2.new(0, 30, 0, 30)
toggleBtn.Position = UDim2.new(0, 0, 0, 0)
toggleBtn.BackgroundColor3 = Color3.fromRGB(255, 0, 0) -- Merah = OFF
toggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
toggleBtn.Text = "OFF"
toggleBtn.Font = Enum.Font.ArialBold
toggleBtn.TextSize = 10
toggleBtn.Parent = screenGui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 6)
corner.Parent = toggleBtn

-- Visual FOV Lingkaran di tengah layar (Menggunakan UI Frame agar work di Mobile)
local fovCircle = Instance.new("Frame")
fovCircle.Size = UDim2.new(0, FOV_RADIUS * 2, 0, FOV_RADIUS * 2)
fovCircle.Position = UDim2.new(0.5, 0, 0.5, 0)
fovCircle.AnchorPoint = Vector2.new(0.5, 0.5)
fovCircle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
fovCircle.BackgroundTransparency = 1
fovCircle.Visible = false
fovCircle.Parent = screenGui

local fovCorner = Instance.new("UICorner")
fovCorner.CornerRadius = UDim.new(1, 0) -- Membuatnya jadi lingkaran sempurna
fovCorner.Parent = fovCircle

local fovStroke = Instance.new("UIStroke")
fovStroke.Color = Color3.fromRGB(255, 0, 0) -- Default Merah
fovStroke.Thickness = 1.5
fovStroke.Parent = fovCircle

-- ==================== AIMBOT LOGIC (DARI DARA HUB) ====================
local function getAimPart(character)
    return character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso")
end

local function isVisible(part)
    if not wallCheckEnabled or not part then return true end
    local character = LocalPlayer.Character
    if not character then return false end
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then return false end
    
    local origin = Camera.CFrame.Position
    local target = part.Position
    local direction = (target - origin)
    
    local rayParams = RaycastParams.new()
    rayParams.FilterDescendantsInstances = {character}
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    
    local rayResult = Workspace:Raycast(origin, direction, rayParams)
    
    if rayResult and not rayResult.Instance:IsDescendantOf(part.Parent) then
        return false -- Kena tembok
    end
    return true
end

local function lookAt(position)
    if not position then return end
    local currentCFrame = Camera.CFrame
    local lookVector = (position - currentCFrame.Position).Unit
    local targetCFrame = CFrame.new(currentCFrame.Position, currentCFrame.Position + lookVector)
    -- Sistem smoothness bawaan Darahub
    local smoothFactor = SMOOTHNESS_VALUE > 0 and (1 / SMOOTHNESS_VALUE) or 1
    Camera.CFrame = currentCFrame:Lerp(targetCFrame, smoothFactor)
end

local function getClosestEnemyInFOV()
    if not Camera then return nil end
    local closestTarget = nil
    local closestDistance = math.huge
    -- FOV selalu di tengah layar (Support Mobile)
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    
    for _, player in ipairs(Players:GetPlayers()) do
        if canTargetPlayer(player) and player.Character then
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
            local aimPartInstance = getAimPart(player.Character)
            
            -- Dead Check
            if humanoid and humanoid.Health > 0 and aimPartInstance then
                local screenPos, onScreen = Camera:WorldToViewportPoint(aimPartInstance.Position)
                if onScreen then
                    local distance = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                    if distance <= FOV_RADIUS and distance < closestDistance and isVisible(aimPartInstance) then
                        closestDistance = distance
                        closestTarget = player
                    end
                end
            end
        end
    end
    return closestTarget
end

-- Loop Utama Aimbot
RunService.RenderStepped:Connect(function()
    if not AIMBOT_ACTIVE then return end
    
    currentTarget = getClosestEnemyInFOV()
    
    if currentTarget and currentTarget.Character then
        local aimPart = getAimPart(currentTarget.Character)
        if aimPart then
            lookAt(aimPart.Position)
            fovStroke.Color = Color3.fromRGB(0, 255, 0) -- Hijau saat terkunci
        end
    else
        fovStroke.Color = Color3.fromRGB(255, 0, 0) -- Merah saat tidak ada target
    end
end)

-- ==================== TOGGLE BUTTON ====================
toggleBtn.MouseButton1Click:Connect(function()
    AIMBOT_ACTIVE = not AIMBOT_ACTIVE
    if AIMBOT_ACTIVE then
        toggleBtn.BackgroundColor3 = Color3.fromRGB(0, 255, 0) -- Hijau = ON
        toggleBtn.Text = "ON"
        fovCircle.Visible = true -- Tampilkan lingkaran FOV
    else
        toggleBtn.BackgroundColor3 = Color3.fromRGB(255, 0, 0) -- Merah = OFF
        toggleBtn.Text = "OFF"
        fovCircle.Visible = false -- Sembunyikan lingkaran FOV
        currentTarget = nil
    end
end)
