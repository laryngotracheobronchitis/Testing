-- Variabel Default
local Smoothness = 0.15 -- 15%
local aimbotActive = false
local lockedTarget = nil
local aimPartMode = "Head" -- Bisa diubah ke "Chest" atau "Pelvis" jika perlu

-- SISTEM AUTO TEAM CHECK
local function isTeamGame()
    local activeTeams = Teams:GetTeams()
    local validTeamCount = 0
    for _, team in ipairs(activeTeams) do
        if team.Name ~= "Spectators" and #team:GetPlayers() > 0 then
            validTeamCount = validTeamCount + 1
        end
    end
    return validTeamCount > 1
end

local function canTargetPlayer(targetPlayer)
    if targetPlayer == LocalPlayer then return false end
    if isTeamGame() then
        if targetPlayer.Team == LocalPlayer.Team then
            return false -- Rekan satu tim
        else
            return true -- Musuh
        end
    else
        return true -- FFA (Semua musuh)
    end
end

-- FUNGSI AIMBOT
local currentCamera = workspace.CurrentCamera

local function getAimPart(character)
    if aimPartMode == "Head" and character:FindFirstChild('Head') then
        return character.Head
    elseif aimPartMode == "Chest" and character:FindFirstChild('HumanoidRootPart') then
        return character.HumanoidRootPart
    elseif aimPartMode == "Pelvis" and character:FindFirstChild('LowerTorso') then
        return character.LowerTorso
    elseif character:FindFirstChild('Head') then
        return character.Head
    end
    return nil
end

local function findTarget()
    local centerScreen = Vector2.new(currentCamera.ViewportSize.X / 2, currentCamera.ViewportSize.Y / 2)
    local radius = frame.Size.X.Offset / 2
    local ignoreChar = LocalPlayer.Character
    
    -- 1. Cek Target Lock yang sudah ada
    if lockedTarget and lockedTarget.Character and lockedTarget.Character:FindFirstChild('Humanoid') and lockedTarget.Character.Humanoid.Health > 0 then
        local part = getAimPart(lockedTarget.Character)
        if part then
            local screenPos, onScreen = currentCamera:WorldToScreenPoint(part.Position)
            local magnitude = (Vector2.new(screenPos.X, screenPos.Y) - centerScreen).Magnitude
            
            if canTargetPlayer(lockedTarget) and onScreen and magnitude <= radius then
                local ray = Ray.new(currentCamera.CFrame.Position, (part.Position - currentCamera.CFrame.Position).Unit * 3000)
                local hit = game.Workspace:FindPartOnRay(ray, ignoreChar, false, true)
                if hit and hit:IsDescendantOf(lockedTarget.Character) then
                    return lockedTarget
                end
            end
        end
    end
    
    -- 2. Cari Target Baru
    lockedTarget = nil
    local closestMagnitude = math.huge
    local newTarget = nil
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild('Humanoid') and player.Character.Humanoid.Health > 0 then
            local part = getAimPart(player.Character)
            
            if part and canTargetPlayer(player) then
                local screenPos, onScreen = currentCamera:WorldToScreenPoint(part.Position)
                local magnitude = (Vector2.new(screenPos.X, screenPos.Y) - centerScreen).Magnitude
                
                if onScreen and magnitude < closestMagnitude and magnitude <= radius then
                    local ray = Ray.new(currentCamera.CFrame.Position, (part.Position - currentCamera.CFrame.Position).Unit * 3000)
                    local hit = game.Workspace:FindPartOnRay(ray, ignoreChar, false, true)
                    if hit and hit:IsDescendantOf(player.Character) then
                        newTarget = player
                        closestMagnitude = magnitude
                    end
                end
            end
        end
    end
    
    lockedTarget = newTarget
    return newTarget
end

-- LOOP RENDERSTEPPED
RunService.RenderStepped:Connect(function()
    if aimbotActive then
        local target = findTarget()
        if target and target.Character then
            local aimPart = getAimPart(target.Character)
            if aimPart then
                local targetCFrame = CFrame.new(currentCamera.CFrame.Position, aimPart.Position)
                if Smoothness >= 0.99 then
                    currentCamera.CFrame = targetCFrame
                else
                    currentCamera.CFrame = currentCamera.CFrame:Lerp(targetCFrame, Smoothness)
                end
            end
        end
    end
end)

-- EVENT TOGGLE TOMBOL
toggleBtn.MouseButton1Click:Connect(function()
